+type tcpInputTLSClientConnection struct {
+	net.Conn
+	response *ber.Packet
+}
+
+func (connection *tcpInputTLSClientConnection) Read(value []byte) (int, error) {
+	if connection.response == nil {
+		response, err := ber.ReadPacket(connection.Conn)
+		if err != nil {
+			return 0, fmt.Errorf("read plaintext StartTLS result: %w", err)
+		}
+		connection.response = response
+	}
+	return connection.Conn.Read(value)
+}
+
+func tcpInputTLSPrefetchHello(t *testing.T, connection *bufferedTCPConnection) []byte {
+	t.Helper()
+	start := connection.end
+	if start+6 > len(connection.buffer) {
+		t.Fatal("no room for TLS record header and ClientHello type")
+	}
+	if _, err := io.ReadFull(connection.tcp, connection.buffer[start:start+5]); err != nil {
+		t.Fatalf("prefetch TLS record header: %v", err)
+	}
+	header := connection.buffer[start : start+5]
+	if header[0] != 22 || header[1] != 3 {
+		t.Fatalf("expected TLS handshake record, got %x", header)
+	}
+	recordSize := int(binary.BigEndian.Uint16(header[3:]))
+	end := min(len(connection.buffer), start+5+recordSize)
+	if recordSize == 0 {
+		t.Fatal("empty TLS handshake record")
+	}
+	if _, err := io.ReadFull(connection.tcp, connection.buffer[start+5:end]); err != nil {
+		t.Fatalf("prefetch ClientHello: %v", err)
+	}
+	if connection.buffer[start+5] != 1 {
+		t.Fatal("first TLS handshake message is not a ClientHello")
+	}
+	connection.end = end
+	return bytes.Clone(connection.buffer[start:end])
+}
+
+type tcpInputTLSProbe struct {
+	config  *tls.Config
+	pending []byte
+	checked chan error
+}
+
+func (transport *tcpInputTLSProbe) ServerHandshake(ctx context.Context, connection net.Conn) (net.Conn, error) {
+	err := transport.checkInput(connection)
+	transport.checked <- err
+	if err != nil {
+		return nil, err
+	}
+	return (standardTLSTransport{config: transport.config}).ServerHandshake(ctx, connection)
+}
+
+func (transport *tcpInputTLSProbe) checkInput(connection net.Conn) error {
+	activity, ok := connection.(*activityTrackingConnection)
+	if !ok {
+		return fmt.Errorf("TLS received %T, want activity-tracking connection", connection)
+	}
+	buffered, ok := activity.Conn.(*bufferedTCPConnection)
+	if !ok {
+		return fmt.Errorf("activity tracking wraps %T, want buffered TCP", activity.Conn)
+	}
+	buffered.readMu.Lock()
+	defer buffered.readMu.Unlock()
+	if len(buffered.buffer) != 1024 {
+		return fmt.Errorf("TCP input buffer size = %d, want 1024", len(buffered.buffer))
+	}
+	if transport.pending != nil && !bytes.Equal(buffered.buffer[buffered.start:buffered.end], transport.pending) {
+		return fmt.Errorf("TLS boundary retained %d bytes, want the exact %d prefetched bytes", buffered.end-buffered.start, len(transport.pending))
+	}
+	return nil
+}
