+func TestTCPInputTLSStartTLSUnreadClientHello(t *testing.T) {
+	for _, test := range []struct {
+		name          string
+		clientVersion uint16
+		serverVersion uint16
+		wantFailure   bool
+	}{
+		{name: "TLS12", clientVersion: tls.VersionTLS12, serverVersion: tls.VersionTLS12},
+		{name: "TLS13", clientVersion: tls.VersionTLS13, serverVersion: tls.VersionTLS13},
+		{name: "version_rejected", clientVersion: tls.VersionTLS13, serverVersion: tls.VersionTLS12, wantFailure: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			store := tcpInputTLSStore(t)
+			configuration := testServerTLSConfig(t)
+			configuration.MaxVersion = test.serverVersion
+			request := tcpInputEncode(t, ldapwire.Message{
+				ID: 41, Request: ldapwire.ExtendedRequest{Name: startTLSOID},
+			})
+			connection, peer := tcpInputPending(t, request)
+			wire := &tcpInputTLSClientConnection{Conn: peer}
+			client := tls.Client(wire, &tls.Config{
+				InsecureSkipVerify: true, // The existing fixture uses a self-signed certificate.
+				MinVersion:         test.clientVersion,
+				MaxVersion:         test.clientVersion,
+			})
+			ctx, cancel := context.WithTimeout(t.Context(), tcpInputTestTimeout)
+			defer cancel()
+			handshakeDone := make(chan error, 1)
+			go func() { handshakeDone <- client.HandshakeContext(ctx) }()
+
+			// No server goroutine owns this socket yet. Preserve real ClientHello
+			// bytes behind the LDAP PDU, irrespective of TCP read boundaries.
+			pending := tcpInputTLSPrefetchHello(t, connection)
+			transport := &tcpInputTLSProbe{
+				config: configuration, pending: pending, checked: make(chan error, 1),
+			}
+			instance, done := tcpInputTLSServeConnection(t, connection, Config{
+				Store: store, SecureTransport: transport,
+			})
+			err := tcpInputAwait(t, handshakeDone)
+			if probeErr := tcpInputAwait(t, transport.checked); probeErr != nil {
+				t.Fatal(probeErr)
+			}
+			assertRawLDAPEnvelope(t, wire.response, 41, ldapwire.ApplicationExtendedResponse, int64(ldapwire.ResultSuccess))
+			if test.wantFailure {
+				if err == nil {
+					t.Fatal("TLS accepted a ClientHello with no supported protocol version")
+				}
+				if timeout, ok := errors.AsType[net.Error](err); ok && timeout.Timeout() {
+					t.Fatalf("TLS version rejection timed out: %v", err)
+				}
+				tcpInputTLSWaitClosed(t, done)
+				tcpInputTLSAssertNoDispatch(t, instance)
+				return
+			}
+			if err != nil {
+				t.Fatalf("StartTLS handshake with buffered ClientHello: %v", err)
+			}
+			if got := client.ConnectionState().Version; got != test.clientVersion {
+				t.Fatalf("TLS version = %#x, want %#x", got, test.clientVersion)
+			}
+			tcpInputTLSBindSearch(t, client)
+		})
+	}
+}
