+package main
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/wangle201210/ldap-go/internal/server"
+)
+
+func TestServeBufferedTCPBeforeSchemeResolverAndMultiplexer(t *testing.T) {
+	for _, secureScheme := range []string{"ldaps", "ldap+tlcp"} {
+		t.Run(secureScheme, func(t *testing.T) {
+			listeners := []net.Listener{listenServeResolverTCP(t), listenServeResolverTCP(t)}
+			for index, listener := range listeners {
+				if err := listener.(*net.TCPListener).SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+					t.Fatal(err)
+				}
+				listeners[index] = server.BufferedTCPListener(listener)
+				if listeners[index] == listener {
+					t.Fatal("native CLI listener was not buffered")
+				}
+			}
+			plain, secure := listeners[0], listeners[1]
+			resolver := serveListenerSchemeResolver(listeners, []string{"ldap://listener/", secureScheme + "://listener/"})
+			marked, ok := listeners[1].(*serveSchemeListener)
+			if resolver == nil || listeners[0] != plain || !ok || marked.Listener != secure {
+				t.Fatal("scheme resolver did not preserve the buffered listeners")
+			}
+			listener := newServeListener(listeners)
+			t.Cleanup(func() { listener.Close() })
+			for index, scheme := range []string{"ldap", secureScheme} {
+				peer, err := net.DialTimeout("tcp", listeners[index].Addr().String(), time.Second)
+				if err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() { peer.Close() })
+				accepted, err := listener.Accept()
+				if err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() { accepted.Close() })
+				if got := resolver(accepted); got != scheme {
+					t.Fatalf("multiplexed scheme = %q, want %q", got, scheme)
+				}
+				input := accepted
+				if index == 1 {
+					marked, ok := accepted.(*serveSchemeConnection)
+					if !ok {
+						t.Fatalf("secure connection lost scheme wrapper: %T", accepted)
+					}
+					input = marked.Conn
+				}
+				if _, raw := input.(*net.TCPConn); raw {
+					t.Fatal("multiplexer accepted unbuffered TCP input")
+				}
+				for _, connection := range []net.Conn{peer, accepted} {
+					if err := connection.SetDeadline(time.Now().Add(time.Second)); err != nil {
+						t.Fatal(err)
+					}
+				}
+				payload := []byte("classified TCP input")
+				if n, err := peer.Write(payload); err != nil || n != len(payload) {
+					t.Fatalf("Write = (%d, %v)", n, err)
+				}
+				got := make([]byte, len(payload))
+				if _, err := io.ReadFull(accepted, got); err != nil || !bytes.Equal(got, payload) {
+					t.Fatalf("ReadFull = (%q, %v)", got, err)
+				}
+			}
+		})
+	}
+}
