+func TestBufferedTCPInputConcurrentMethods(t *testing.T) {
+	connection, peer := tcpInputPair(t, true)
+	const size = 512
+	if err := tcpInputWriteChunks(peer, bytes.Repeat([]byte{'r'}, 2*size), 0); err != nil {
+		t.Fatal(err)
+	}
+	start := make(chan struct{})
+	results := make(chan error, 8)
+	deadline := time.Now().Add(tcpInputTestTimeout)
+	jobs := []func() error{
+		func() error {
+			got := make([]byte, 2*size)
+			if _, err := io.ReadFull(peer, got); err != nil {
+				return err
+			}
+			if !bytes.Equal(got, bytes.Repeat([]byte{'w'}, len(got))) {
+				return errors.New("concurrent writes changed data")
+			}
+			return nil
+		},
+		func() error { return connection.SetReadDeadline(deadline) },
+		func() error { return connection.SetWriteDeadline(deadline) },
+		func() error { return connection.SetDeadline(deadline) },
+	}
+	for range 2 {
+		jobs = append(jobs, func() error {
+			got := make([]byte, size)
+			if _, err := io.ReadFull(connection, got); err != nil {
+				return err
+			}
+			if !bytes.Equal(got, bytes.Repeat([]byte{'r'}, size)) {
+				return errors.New("concurrent reads changed data")
+			}
+			return nil
+		}, func() error {
+			return tcpInputWriteChunks(connection, bytes.Repeat([]byte{'w'}, size), 17)
+		})
+	}
+	var workers sync.WaitGroup
+	for _, job := range jobs {
+		workers.Go(func() {
+			<-start
+			results <- job()
+		})
+	}
+	close(start)
+	for range jobs {
+		if err := tcpInputAwait(t, results); err != nil {
+			t.Fatal(err)
+		}
+	}
+	workers.Wait()
+
+	// Race Close with all deadline setters and address queries on the same socket.
+	start = make(chan struct{})
+	closingJobs := []func() error{
+		connection.Close,
+		func() error { return connection.SetDeadline(deadline) },
+		func() error { return connection.SetReadDeadline(deadline) },
+		func() error { return connection.SetWriteDeadline(deadline) },
+		func() error {
+			connection.LocalAddr()
+			connection.RemoteAddr()
+			return nil
+		},
+		func() error { _, err := connection.Read(make([]byte, 1)); return err },
+		func() error { _, err := connection.Write([]byte{'c'}); return err },
+	}
+	for _, operation := range closingJobs {
+		workers.Go(func() {
+			<-start
+			results <- operation()
+		})
+	}
+	close(start)
+	for range closingJobs {
+		if err := tcpInputAwait(t, results); err != nil && !errors.Is(err, net.ErrClosed) {
+			t.Fatal(err)
+		}
+	}
+	workers.Wait()
+}
