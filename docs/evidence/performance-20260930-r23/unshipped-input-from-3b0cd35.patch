+func tcpInputAssertMessage(t *testing.T, got, want ldapwire.Message) {
+	t.Helper()
+	bind, ok := got.Request.(ldapwire.BindRequest)
+	expected := want.Request.(ldapwire.BindRequest)
+	if got.ID != want.ID || !ok || bind.Version != expected.Version || bind.Name != expected.Name ||
+		!bytes.Equal(bind.Authentication.Simple, expected.Authentication.Simple) {
+		t.Fatalf("decoded PDU mismatch: id = %d, request = %#v, want id = %d, request = %#v", got.ID, got.Request, want.ID, want.Request)
+	}
+}
+
+func tcpInputWriteChunks(connection net.Conn, data []byte, chunkSize int) error {
+	if chunkSize <= 0 {
+		chunkSize = len(data)
+	}
+	for len(data) > 0 {
+		chunk := data[:min(chunkSize, len(data))]
+		n, err := connection.Write(chunk)
+		if err != nil {
+			return err
+		}
+		if n != len(chunk) {
+			return io.ErrShortWrite
+		}
+		data = data[n:]
+	}
+	return nil
+}
+
+func tcpInputAwait(t *testing.T, result <-chan error) error {
+	t.Helper()
+	select {
+	case err := <-result:
+		return err
+	case <-time.After(tcpInputTestTimeout):
+		t.Fatal("TCP operation did not finish within the test bound")
+		return nil
+	}
+}
+
+type tcpInputListenerWrapper struct{ net.Listener }
+type tcpInputEmbeddedListener struct{ *net.TCPListener }
+
+type tcpInputReaderFunc func([]byte) (int, error)
+
+func (read tcpInputReaderFunc) Read(buffer []byte) (int, error) { return read(buffer) }
+
+type tcpInputCustomListener struct {
+	connection net.Conn
+	address    net.Addr
+	acceptErr  error
+	closeErr   error
+	closes     int
+}
+
+func (listener *tcpInputCustomListener) Accept() (net.Conn, error) {
+	return listener.connection, listener.acceptErr
+}
+
+func (listener *tcpInputCustomListener) Addr() net.Addr { return listener.address }
+
+func (listener *tcpInputCustomListener) Close() error {
+	listener.closes++
+	return listener.closeErr
+}
