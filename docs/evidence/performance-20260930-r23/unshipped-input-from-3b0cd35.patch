new file mode 100644
index 0000000..9d49bfa
--- /dev/null
+++ b/internal/server/tcp_input.go
@@ -0,0 +1,164 @@
+package server
+
+import (
+	"net"
+	"os"
+	"sync"
+	"time"
+)
+
+const tcpInputBufferSize = 1024
+
+// BufferedTCPListener buffers input only on sockets accepted by a native TCP
+// listener. Other listeners, including an already buffered listener, are unchanged.
+func BufferedTCPListener(listener net.Listener) net.Listener {
+	tcp, ok := listener.(*net.TCPListener)
+	if !ok || tcp == nil {
+		return listener
+	}
+	return &bufferedTCPListener{tcp: tcp}
+}
+
+type bufferedTCPListener struct {
+	tcp *net.TCPListener
+}
+
+func (listener *bufferedTCPListener) Accept() (net.Conn, error) {
+	connection, err := listener.tcp.AcceptTCP()
+	if err != nil {
+		return nil, err
+	}
+	return &bufferedTCPConnection{tcp: connection}, nil
+}
+
+func (listener *bufferedTCPListener) Close() error {
+	return listener.tcp.Close()
+}
+
+func (listener *bufferedTCPListener) Addr() net.Addr {
+	return listener.tcp.Addr()
+}
+
+// The native accept owns the socket before any reads or deadline changes. Keep
+// it private so later lifecycle calls cannot bypass the buffered input state.
+type bufferedTCPConnection struct {
+	tcp *net.TCPConn
+
+	readMu     sync.Mutex
+	buffer     [tcpInputBufferSize]byte
+	start, end int
+	pending    error
+
+	stateMu      sync.Mutex
+	closed       bool
+	readDeadline time.Time
+}
+
+func (connection *bufferedTCPConnection) Read(value []byte) (int, error) {
+	connection.readMu.Lock()
+	defer connection.readMu.Unlock()
+	if len(value) == 0 {
+		return connection.tcp.Read(value)
+	}
+
+	for {
+		connection.stateMu.Lock()
+		if err := connection.readErrorLocked(); err != nil {
+			connection.stateMu.Unlock()
+			return 0, err
+		}
+		if connection.start < connection.end {
+			count := copy(value, connection.buffer[connection.start:connection.end])
+			clear(connection.buffer[connection.start : connection.start+count])
+			connection.start += count
+			var err error
+			if connection.start == connection.end {
+				connection.start, connection.end = 0, 0
+				err, connection.pending = connection.pending, nil
+			}
+			connection.stateMu.Unlock()
+			return count, err
+		}
+		connection.stateMu.Unlock()
+
+		// A blocking socket read must leave stateMu available to Close and
+		// deadline setters. Recheck that state before delivering prefetched bytes.
+		if len(value) >= len(connection.buffer) {
+			return connection.tcp.Read(value)
+		}
+		count, err := connection.tcp.Read(connection.buffer[:])
+		if count == 0 {
+			return 0, err
+		}
+		connection.start, connection.end, connection.pending = 0, count, err
+	}
+}
+
+func (connection *bufferedTCPConnection) readErrorLocked() error {
+	var err error
+	if connection.closed {
+		err = net.ErrClosed
+	} else if !connection.readDeadline.IsZero() && !time.Now().Before(connection.readDeadline) {
+		err = os.ErrDeadlineExceeded
+	}
+	if err == nil {
+		return nil
+	}
+	return &net.OpError{
+		Op:     "read",
+		Net:    "tcp",
+		Source: connection.tcp.LocalAddr(),
+		Addr:   connection.tcp.RemoteAddr(),
+		Err:    err,
+	}
+}
+
+func (connection *bufferedTCPConnection) Write(value []byte) (int, error) {
+	return connection.tcp.Write(value)
+}
+
+func (connection *bufferedTCPConnection) Close() error {
+	connection.stateMu.Lock()
+	connection.closed = true
+	connection.stateMu.Unlock()
+
+	// Interrupt an in-flight refill before waiting to clear its buffer.
+	err := connection.tcp.Close()
+	connection.readMu.Lock()
+	clear(connection.buffer[:])
+	connection.start, connection.end, connection.pending = 0, 0, nil
+	connection.readMu.Unlock()
+	return err
+}
+
+func (connection *bufferedTCPConnection) LocalAddr() net.Addr {
+	return connection.tcp.LocalAddr()
+}
+
+func (connection *bufferedTCPConnection) RemoteAddr() net.Addr {
+	return connection.tcp.RemoteAddr()
+}
+
+func (connection *bufferedTCPConnection) SetDeadline(deadline time.Time) error {
+	connection.stateMu.Lock()
+	defer connection.stateMu.Unlock()
+	if err := connection.tcp.SetDeadline(deadline); err != nil {
+		return err
+	}
+	connection.readDeadline = deadline
+	return nil
+}
+
+func (connection *bufferedTCPConnection) SetReadDeadline(deadline time.Time) error {
+	connection.stateMu.Lock()
+	defer connection.stateMu.Unlock()
+	if err := connection.tcp.SetReadDeadline(deadline); err != nil {
+		return err
+	}
+	connection.readDeadline = deadline
+	return nil
+}
+
+func (connection *bufferedTCPConnection) SetWriteDeadline(deadline time.Time) error {
+	return connection.tcp.SetWriteDeadline(deadline)
+}
