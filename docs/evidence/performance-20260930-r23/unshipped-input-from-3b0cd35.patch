+func tcpInputTLSStore(t *testing.T) storage.Store {
+	t.Helper()
+	store := storage.NewMemory()
+	t.Cleanup(func() { _ = store.Close() })
+	seedDirectory(t, store)
+	seedSASLPlainConfiguration(t, store, "noplain,noanonymous")
+	return store
+}
+
+func tcpInputTLSServeConnection(t *testing.T, connection net.Conn, config Config) (*Server, <-chan struct{}) {
+	t.Helper()
+	config.SecureHandshakeTimeout = tcpInputTestTimeout
+	instance, err := New(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	instance.connections[connection] = struct{}{}
+	done := make(chan struct{})
+	instance.wg.Add(1)
+	go func() {
+		defer close(done)
+		instance.serveConnection(ctx, connection)
+	}()
+	t.Cleanup(func() {
+		cancel()
+		_ = connection.Close()
+		tcpInputTLSWaitClosed(t, done)
+		instance.monitor.closeLogFile()
+		instance.closeSQLBackends()
+		instance.metaTransports.close()
+	})
+	return instance, done
+}
+
+func tcpInputTLSWaitClosed(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(tcpInputTestTimeout):
+		t.Fatal("buffered TLS connection did not stop within the test bound")
+	}
+}
+
+func tcpInputTLSAssertNoDispatch(t *testing.T, instance *Server) {
+	t.Helper()
+	for _, request := range []ldapwire.Request{ldapwire.BindRequest{}, ldapwire.SearchRequest{}} {
+		index, ok := monitorOperationIndex(request)
+		if !ok {
+			t.Fatalf("no monitor counter for %T", request)
+		}
+		if got := instance.monitor.operations[index].initiated.Load(); got != 0 {
+			t.Errorf("dispatched %d plaintext %T operations after StartTLS", got, request)
+		}
+	}
+	instance.mu.Lock()
+	remaining := len(instance.connections)
+	instance.mu.Unlock()
+	if remaining != 0 {
+		t.Errorf("failed TLS connection remains registered: %d", remaining)
+	}
+}
