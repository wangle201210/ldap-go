+func tcpInputTLSBindSearch(t *testing.T, connection *tls.Conn) {
+	t.Helper()
+	if err := bindSASLPlainConnection(connection, "", "alice", "secret"); err != nil {
+		t.Fatalf("SASL PLAIN over buffered TLS: %v", err)
+	}
+	if err := connection.SetDeadline(time.Now().Add(tcpInputTestTimeout)); err != nil {
+		t.Fatal(err)
+	}
+	client := ldap.NewConn(connection, true)
+	client.SetTimeout(tcpInputTestTimeout)
+	client.Start()
+	defer client.Close()
+	for _, mechanism := range []string{"SASL PLAIN", "simple"} {
+		if mechanism == "simple" {
+			if err := client.Bind("uid=alice,ou=people,dc=example,dc=com", "secret"); err != nil {
+				t.Fatalf("simple Bind over buffered TLS: %v", err)
+			}
+		}
+		result, err := client.Search(ldap.NewSearchRequest(
+			"uid=alice,ou=people,dc=example,dc=com", ldap.ScopeBaseObject,
+			ldap.NeverDerefAliases, 0, 0, false, "(objectClass=inetOrgPerson)", []string{"uid"}, nil,
+		))
+		if err != nil || len(result.Entries) != 1 || result.Entries[0].GetAttributeValue("uid") != "alice" {
+			t.Fatalf("Search after %s over buffered TLS = %#v, %v", mechanism, result, err)
+		}
+	}
+}
