+func TestBufferedTCPInputInterruptBlockedRead(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		interrupt func(net.Conn) error
+		wantErr   error
+	}{
+		{name: "Close", interrupt: net.Conn.Close, wantErr: net.ErrClosed},
+		{
+			name: "SetReadDeadline",
+			interrupt: func(connection net.Conn) error {
+				return connection.SetReadDeadline(time.Now().Add(-time.Second))
+			},
+			wantErr: os.ErrDeadlineExceeded,
+		},
+		{
+			name: "SetDeadline",
+			interrupt: func(connection net.Conn) error {
+				return connection.SetDeadline(time.Now().Add(-time.Second))
+			},
+			wantErr: os.ErrDeadlineExceeded,
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			connection, peer := tcpInputPair(t, true)
+			started := make(chan error, 1)
+			readDone := make(chan error, 1)
+			go func() {
+				started <- nil
+				var buffer [1]byte
+				n, err := connection.Read(buffer[:])
+				if n != 0 || !errors.Is(err, test.wantErr) {
+					readDone <- fmt.Errorf("interrupted Read = (%d, %v), want (0, %v)", n, err, test.wantErr)
+					return
+				}
+				readDone <- nil
+			}()
+			tcpInputAwait(t, started)
+			select {
+			case err := <-readDone:
+				t.Fatalf("read completed before interruption: %v", err)
+			case <-time.After(20 * time.Millisecond):
+			}
+			interruptDone := make(chan error, 1)
+			go func() { interruptDone <- test.interrupt(connection) }()
+			if err := tcpInputAwait(t, interruptDone); err != nil {
+				t.Fatalf("interrupt read: %v", err)
+			}
+			if err := tcpInputAwait(t, readDone); err != nil {
+				t.Fatal(err)
+			}
+			if test.name != "Close" {
+				if err := connection.SetDeadline(time.Time{}); err != nil {
+					t.Fatal(err)
+				}
+				if err := tcpInputWriteChunks(peer, []byte{'r'}, 0); err != nil {
+					t.Fatal(err)
+				}
+				var got [1]byte
+				if _, err := io.ReadFull(connection, got[:]); err != nil || got[0] != 'r' {
+					t.Fatalf("Read after clearing interrupt = (%q, %v)", got, err)
+				}
+			}
+		})
+	}
+}
