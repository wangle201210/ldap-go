+func TestTCPInputTLSStartTLSFailureDoesNotDispatchPlaintext(t *testing.T) {
+	store := tcpInputTLSStore(t)
+	startTLS := tcpInputEncode(t, ldapwire.Message{
+		ID: 41, Request: ldapwire.ExtendedRequest{Name: startTLSOID},
+	})
+	bind := tcpInputEncode(t, ldapwire.Message{
+		ID: 42,
+		Request: ldapwire.BindRequest{
+			Version: 3, Name: "uid=alice,ou=people,dc=example,dc=com",
+			Authentication: ldapwire.Authentication{Simple: []byte("secret")},
+		},
+	})
+	search := tcpInputEncode(t, ldapwire.Message{
+		ID: 43,
+		Request: ldapwire.SearchRequest{
+			BaseDN: "uid=alice,ou=people,dc=example,dc=com",
+			Filter: directory.Filter{Kind: directory.FilterPresent, Attribute: "objectClass"},
+		},
+	})
+	pending := append(bind, search...)
+	connection, peer := tcpInputPending(t, append(startTLS, pending...))
+	transport := &tcpInputTLSProbe{
+		config: testServerTLSConfig(t), pending: pending, checked: make(chan error, 1),
+	}
+	instance, done := tcpInputTLSServeConnection(t, connection, Config{
+		Store: store, SecureTransport: transport,
+	})
+	assertRawLDAPEnvelope(t, readRawLDAPPacket(t, peer), 41, ldapwire.ApplicationExtendedResponse, int64(ldapwire.ResultSuccess))
+	if err := tcpInputAwait(t, transport.checked); err != nil {
+		t.Fatal(err)
+	}
+	// Valid LDAP requests are invalid TLS records. Neither a Bind response nor
+	// a fallback LDAP notice may follow the already committed StartTLS success.
+	var next [1]byte
+	if n, err := peer.Read(next[:]); n != 0 || !errors.Is(err, io.EOF) {
+		t.Fatalf("after failed TLS handshake: Read = (%d, %v), byte = %x; want EOF", n, err, next)
+	}
+	tcpInputTLSWaitClosed(t, done)
+	tcpInputTLSAssertNoDispatch(t, instance)
+}
+
+func TestTCPInputTLSImplicitTLSBindSearch(t *testing.T) {
+	store := tcpInputTLSStore(t)
+	transport := &tcpInputTLSProbe{
+		config: testServerTLSConfig(t), checked: make(chan error, 1),
+	}
+	// startServer passes a native TCP listener to Serve with both custom
+	// classifiers nil, so the probe also verifies automatic buffering.
+	address, stop := startServer(t, store, Config{
+		SecureTransport: transport, ImplicitTLS: true,
+	})
+	defer stop()
+	peer, err := net.DialTimeout("tcp", address, tcpInputTestTimeout)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	guard := time.AfterFunc(tcpInputTestTimeout, func() { peer.Close() })
+	defer guard.Stop()
+	if err := peer.SetDeadline(time.Now().Add(tcpInputTestTimeout)); err != nil {
+		t.Fatal(err)
+	}
+	client := tls.Client(peer, &tls.Config{
+		InsecureSkipVerify: true, // The existing fixture uses a self-signed certificate.
+		MinVersion:         tls.VersionTLS12,
+	})
+	ctx, cancel := context.WithTimeout(t.Context(), tcpInputTestTimeout)
+	defer cancel()
+	if err := client.HandshakeContext(ctx); err != nil {
+		t.Fatalf("implicit TLS handshake: %v", err)
+	}
+	if err := tcpInputAwait(t, transport.checked); err != nil {
+		t.Fatal(err)
+	}
+	tcpInputTLSBindSearch(t, client)
+}
