+)
+
+func TestTCPInputServeListenerSelectionAndOwnership(t *testing.T) {
+	for _, name := range []string{"native", "implicit_classifier", "scheme_classifier", "both_classifiers", "custom_listener", "explicit_buffer_with_classifier"} {
+		t.Run(name, func(t *testing.T) {
+			var listener net.Listener = tcpInputListener(t)
+			config := Config{}
+			classified := make(chan net.Conn, 2)
+			if name == "implicit_classifier" || name == "both_classifiers" {
+				config.ImplicitTLSForConnection = func(connection net.Conn) bool {
+					classified <- connection
+					return false
+				}
+			}
+			if name == "scheme_classifier" || name == "both_classifiers" || name == "explicit_buffer_with_classifier" {
+				config.ListenerSchemeForConnection = func(connection net.Conn) string {
+					classified <- connection
+					return "ldap"
+				}
+			}
+			if config.ImplicitTLSForConnection != nil || config.ListenerSchemeForConnection != nil {
+				config.TLSConfig = testServerTLSConfig(t)
+			}
+			if name == "custom_listener" {
+				listener = &tcpInputListenerWrapper{Listener: listener}
+			} else if name == "explicit_buffer_with_classifier" {
+				listener = BufferedTCPListener(listener)
+			}
+			instance, cancel, wait := startTCPInputIntegrationServer(t, listener, config)
+			peer, err := net.DialTimeout("tcp", listener.Addr().String(), tcpInputTestTimeout)
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { peer.Close() })
+			if err := peer.SetDeadline(time.Now().Add(tcpInputTestTimeout)); err != nil {
+				t.Fatal(err)
+			}
+			writeRawLDAPRequest(t, peer, 1, rawExtendedRequest(whoAmIOID, nil, false), nil)
+			assertRawLDAPEnvelope(t, readRawLDAPPacket(t, peer), 1,
+				ldapwire.ApplicationExtendedResponse, int64(ldapwire.ResultSuccess))
+			owned, registry := tcpInputIntegrationOwnedConnection(t, instance)
+			controlled, buffered := owned.(*bufferedTCPConnection)
+			wantBuffered := name == "native" || name == "explicit_buffer_with_classifier"
+			if buffered != wantBuffered {
+				t.Fatalf("registered connection = %T, want buffered=%v", owned, wantBuffered)
+			}
+			if !wantBuffered {
+				if _, ok := owned.(*net.TCPConn); !ok {
+					t.Fatalf("fallback registered %T, want original *net.TCPConn", owned)
+				}
+			}
+			if config.ImplicitTLSForConnection != nil || config.ListenerSchemeForConnection != nil {
+				select {
+				case original := <-classified:
+					if original != owned {
+						t.Fatalf("classifier saw %T %p, registry owns %T %p", original, original, owned, owned)
+					}
+				default:
+					t.Fatal("custom classifier was not called")
+				}
+			}
+			cancel()
+			if err := wait(); err != nil {
+				t.Fatal(err)
+			}
+			assertConnectionTimeoutClosesSilently(t, peer, time.Second)
+			if registry.hasOutstanding() {
+				t.Fatal("shutdown left registered operations")
+			}
+			assertInlineBindTestReleased(t, instance)
+			if buffered {
+				controlled.stateMu.Lock()
+				closed := controlled.closed
+				controlled.stateMu.Unlock()
+				if !closed {
+					t.Fatal("shutdown bypassed the controlled input Close")
+				}
+			}
+			instance.mu.Lock()
+			connections, operations := len(instance.connections), len(instance.connectionOperations)
+			instance.mu.Unlock()
+			if connections != 0 || operations != 0 {
+				t.Fatalf("shutdown retained connections=%d registries=%d", connections, operations)
+			}
+		})
+	}
+}
+
+func TestTCPInputPrefetchedBindIdentityAndIncomingLimit(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		rebind   bool
+		dn       string
+		password string
+		code     ldapwire.ResultCode
+		identity string
+	}{
+		{name: "success", dn: inlineBindRootDN, password: "admin-secret", identity: "dn:" + inlineBindRootDN},
+		{name: "failed_rebind", rebind: true, dn: inlineBindRootDN, password: "wrong", code: ldapwire.ResultInvalidCredentials},
+		{name: "anonymous_rebind", rebind: true},
+	} {
+		for _, mode := range []string{"identity", "incoming_limit"} {
+			t.Run(test.name+"/"+mode, func(t *testing.T) {
+				store := storage.NewMemory()
+				t.Cleanup(func() { store.Close() })
+				seedDirectory(t, store)
+				putIncomingLimitRuntimeEntry(t, store, 128, 1024)
+				who := ldapwire.Message{ID: 4, Request: ldapwire.ExtendedRequest{Name: whoAmIOID}}
+				if mode == "incoming_limit" {
+					who.Controls = []ldapwire.Control{{OID: "1.3.6.1.4.1.4203.666.999", HasValue: true, Value: make([]byte, 384)}}
+				}
+				request := tcpInputEncode(t, who)
+				if mode == "incoming_limit" {
+					if content := ldapFrameContentLength(t, request); content <= 128 || content > 1024 {
+						t.Fatalf("request content length = %d, want between the two limits", content)
+					}
+				}
+				var pipeline []byte
+				if test.rebind {
+					pipeline = tcpInputEncode(t, inlineBindTestMessage(1, inlineBindRootDN, "admin-secret"))
+				}
+				pipeline = append(pipeline, tcpInputEncode(t, inlineBindTestMessage(3, test.dn, test.password))...)
+				pipeline = append(pipeline, request...)
+				connection, peer := tcpInputPending(t, pipeline)
+				listener := &tcpInputPreloadedListener{Listener: tcpInputListener(t), connection: connection}
+				instance, cancel, wait := startTCPInputIntegrationServer(t, listener, Config{Store: store})
+				if test.rebind {
+					assertRawLDAPEnvelope(t, readRawLDAPPacket(t, peer), 1,
+						ldapwire.ApplicationBindResponse, int64(ldapwire.ResultSuccess))
+				}
+				assertRawLDAPEnvelope(t, readRawLDAPPacket(t, peer), 3,
+					ldapwire.ApplicationBindResponse, int64(test.code))
+				if mode == "incoming_limit" && test.identity == "" {
+					assertIncomingLimitSilentClose(t, peer)
+				} else {
+					response := readRawLDAPPacket(t, peer)
+					assertRawLDAPEnvelope(t, response, 4, ldapwire.ApplicationExtendedResponse, int64(ldapwire.ResultSuccess))
+					value, present := rawExtendedResponseValue(response)
+					if !present || string(value) != test.identity {
+						t.Fatalf("prefetched Who Am I = %q, present=%v; want %q", value, present, test.identity)
+					}
+				}
+				cancel()
+				if err := wait(); err != nil {
+					t.Fatal(err)
+				}
+				assertInlineBindTestReleased(t, instance)
+			})
+		}
+	}
+}
+
+func TestTCPInputIdleTimeoutAfterPrefetchedBindAndPartialRequest(t *testing.T) {
+	store := storage.NewMemory()
+	t.Cleanup(func() { store.Close() })
+	seedDirectory(t, store)
+	putConnectionTimeoutGlobalEntry(t, store, []string{"1"}, nil)
+	pipeline := tcpInputEncode(t, inlineBindTestMessage(1, inlineBindRootDN, "admin-secret"))
+	pipeline = append(pipeline, 0x30, 0x10, 0x02, 0x01, 0x02)
+	connection, peer := tcpInputPending(t, pipeline)
+	listener := &tcpInputPreloadedListener{Listener: tcpInputListener(t), connection: connection}
+	started := time.Now()
+	instance, cancel, wait := startTCPInputIntegrationServer(t, listener, Config{Store: store})
+	assertRawLDAPEnvelope(t, readRawLDAPPacket(t, peer), 1,
+		ldapwire.ApplicationBindResponse, int64(ldapwire.ResultSuccess))
+	owned, _ := tcpInputIntegrationOwnedConnection(t, instance)
+	if owned != connection {
+		t.Fatal("idle watcher does not own the preloaded connection")
+	}
+	assertConnectionTimeoutClosesSilently(t, peer, 3*time.Second)
+	if elapsed := time.Since(started); elapsed < 700*time.Millisecond {
+		t.Fatalf("partial PDU closed before the idle timeout: %s", elapsed)
+	}
+	waitForServerConnectionCount(t, instance, 0)
+	cancel()
+	if err := wait(); err != nil {
+		t.Fatal(err)
+	}
+	assertInlineBindTestReleased(t, instance)
+}
+
+func TestTCPInputCancelBypassesPendingLimit(t *testing.T) {
+	store := newCancelBlockingStore(storage.NewMemory())
+	t.Cleanup(func() { store.Close() })
+	seedDirectory(t, store)
+	putConnectionPendingGlobalEntry(t, store, []string{"0"}, []string{"0"})
+	listener := tcpInputListener(t)
+	instance, cancel, wait := startTCPInputIntegrationServer(t, listener, Config{Store: store})
+	peer := dialAndBindRawLDAP(t, listener.Addr().String(), inlineBindRootDN, "admin-secret")
+	t.Cleanup(func() { peer.Close() })
+	if err := peer.SetDeadline(time.Now().Add(tcpInputTestTimeout)); err != nil {
+		t.Fatal(err)
+	}
+	gate := store.blockNextSearch()
+	writeRawLDAPRequest(t, peer, 2, rawCancellationSearch(t), nil)
+	gate.waitUntilBlocked(t)
+	owned, registry := tcpInputIntegrationOwnedConnection(t, instance)
+	if _, ok := owned.(*bufferedTCPConnection); !ok || !registry.contains(2) {
+		t.Fatalf("blocked Search is not registered on controlled TCP input: %T", owned)
+	}
+	assertLDAPConnectionHasNoResponse(t, peer)
+	if err := peer.SetReadDeadline(time.Now().Add(tcpInputTestTimeout)); err != nil {
+		t.Fatal(err)
+	}
+	writeRawLDAPRequest(t, peer, 3, rawExtendedRequest(cancelOID, ldapwire.EncodeCancelRequestValue(2), true), nil)
+	assertRawLDAPEnvelope(t, readRawLDAPPacket(t, peer), 2,
+		ldapwire.ApplicationSearchResultDone, int64(ldapwire.ResultCanceled))
+	assertRawLDAPEnvelope(t, readRawLDAPPacket(t, peer), 3,
+		ldapwire.ApplicationExtendedResponse, int64(ldapwire.ResultSuccess))
+	select {
+	case <-gate.resumed:
+	case <-time.After(tcpInputTestTimeout):
+		t.Fatal("Cancel did not release the storage scan")
+	}
+	writeRawLDAPRequest(t, peer, 4, rawExtendedRequest(whoAmIOID, nil, false), nil)
+	assertRawLDAPEnvelope(t, readRawLDAPPacket(t, peer), 4,
+		ldapwire.ApplicationExtendedResponse, int64(ldapwire.ResultSuccess))
+	cancel()
+	if err := wait(); err != nil {
+		t.Fatal(err)
+	}
+	assertInlineBindTestReleased(t, instance)
+}
+
+func TestTCPInputShutdownWithPrefetchedRequestBehindBind(t *testing.T) {
+	for _, mode := range []string{"graceful", "forced"} {
+		t.Run(mode, func(t *testing.T) {
+			store := newResourceLimitStore(storage.NewMemory())
+			t.Cleanup(func() { store.Close() })
+			seedDirectory(t, store)
+			following := tcpInputEncode(t, ldapwire.Message{ID: 2, Request: ldapwire.ExtendedRequest{Name: whoAmIOID}})
+			pipeline := tcpInputEncode(t, inlineBindTestMessage(1, "uid=alice,ou=people,dc=example,dc=com", "secret"))
+			connection, peer := tcpInputPending(t, append(pipeline, following...))
+			listener := &tcpInputPreloadedListener{Listener: tcpInputListener(t), connection: connection}
+			shutdownTimeout := time.Second
+			if mode == "forced" {
+				shutdownTimeout = 200 * time.Millisecond
+			}
+			instance, cancel, wait := startTCPInputIntegrationServer(t, listener, Config{
+				Store: store, Ready: store.enable, ShutdownTimeout: shutdownTimeout,
+			})
+			t.Cleanup(store.unblock)
+			select {
+			case <-store.entered:
+			case <-time.After(tcpInputTestTimeout):
+				t.Fatal("prefetched Bind did not reach storage")
+			}
+			owned, registry := tcpInputIntegrationOwnedConnection(t, instance)
+			if owned != connection || !registry.contains(1) || registry.contains(2) {
+				t.Fatal("Bind did not retain its registry and reader barrier")
+			}
+			connection.readMu.Lock()
+			pending := bytes.Equal(connection.buffer[connection.start:connection.end], following)
+			connection.readMu.Unlock()
+			if !pending {
+				t.Fatal("following request was not pending in the private input buffer")
+			}
+			cancel()
+			bound := time.Now().Add(tcpInputTestTimeout)
+			for {
+				connection.stateMu.Lock()
+				deadline := connection.readDeadline
+				connection.stateMu.Unlock()
+				if !deadline.IsZero() && !deadline.After(time.Now()) {
+					break
+				}
+				if time.Now().After(bound) {
+					t.Fatal("Serve cancellation did not expire the controlled read deadline")
+				}
+				time.Sleep(time.Millisecond)
+			}
+			if mode == "graceful" {
+				if !registry.contains(1) || store.active.Load() != 1 {
+					t.Fatal("graceful drain canceled the active Bind")
+				}
+				store.unblock()
+				assertRawLDAPEnvelope(t, readRawLDAPPacket(t, peer), 1,
+					ldapwire.ApplicationBindResponse, int64(ldapwire.ResultSuccess))
+				if err := wait(); err != nil {
+					t.Fatal(err)
+				}
+			} else if err := wait(); !errors.Is(err, ErrShutdownTimeout) {
+				t.Fatalf("forced drain = %v, want shutdown timeout", err)
+			}
+			assertConnectionTimeoutClosesSilently(t, peer, time.Second)
+			if registry.hasOutstanding() || store.active.Load() != 0 {
+				t.Fatal("shutdown retained the blocked Bind")
+			}
+			assertInlineBindTestReleased(t, instance)
+			if n, err := connection.Read(make([]byte, 1)); n != 0 || !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("read after shutdown = (%d, %v), want closed", n, err)
+			}
+			if connection.start != 0 || connection.end != 0 || connection.buffer != [tcpInputBufferSize]byte{} {
+				t.Fatal("shutdown did not clear prefetched request bytes")
+			}
+		})
+	}
+}
+
+// Only the first Accept is supplied by the fixture; subsequent accepts and
+// shutdown still use a real TCP listener. tcpInputPending owns preloading.
+type tcpInputPreloadedListener struct {
+	net.Listener
+	connection net.Conn
+}
+
+func (listener *tcpInputPreloadedListener) Accept() (net.Conn, error) {
+	if connection := listener.connection; connection != nil {
+		listener.connection = nil
+		return connection, nil
+	}
+	return listener.Listener.Accept()
+}
+
+func startTCPInputIntegrationServer(t *testing.T, listener net.Listener, config Config) (*Server, context.CancelFunc, func() error) {
+	t.Helper()
+	if config.Store == nil {
+		store := storage.NewMemory()
+		t.Cleanup(func() { store.Close() })
+		seedDirectory(t, store)
+		config.Store = store
+	}
+	config.RootDN, config.RootPassword = inlineBindRootDN, []byte("admin-secret")
+	if config.ShutdownTimeout == 0 {
+		config.ShutdownTimeout = time.Second
+	}
+	instance, err := New(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	done := make(chan error, 1)
+	go func() { done <- instance.Serve(ctx, listener) }()
+	wait := sync.OnceValue(func() error { return tcpInputAwait(t, done) })
+	t.Cleanup(func() {
+		cancel()
+		if err := wait(); err != nil && !errors.Is(err, ErrShutdownTimeout) {
+			t.Errorf("Serve: %v", err)
+		}
+	})
+	return instance, cancel, wait
+}
+
+func tcpInputIntegrationOwnedConnection(t *testing.T, instance *Server) (net.Conn, *operationRegistry) {
+	t.Helper()
+	instance.mu.Lock()
+	defer instance.mu.Unlock()
+	if len(instance.connections) != 1 || len(instance.connectionOperations) != 1 {
+		t.Fatalf("connections=%d registries=%d, want one of each", len(instance.connections), len(instance.connectionOperations))
+	}
+	for connection := range instance.connections {
+		registry := instance.connectionOperations[connection]
+		if registry == nil {
+			t.Fatal("operation registry is keyed by a different connection handle")
+		}
+		return connection, registry
+	}
+	return nil, nil
+}
diff --git a/internal/server/tcp_input_sasl_test.go b/internal/server/tcp_input_sasl_test.go
new file mode 100644
index 0000000..e4c1420
--- /dev/null
+++ b/internal/server/tcp_input_sasl_test.go
@@ -0,0 +1,243 @@
+package server
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"testing"
+
+	"github.com/wangle201210/ldap-go/internal/ldapwire"
+	"github.com/wangle201210/ldap-go/internal/saslkrb5"
+)
+
+// These are transport/security-layer tests, not authentication or server-loop
+// tests. A synthetic final SASL BindRequest is consumed before installing the
+// real negotiated layer with fixed keys. Both sides of that boundary are already
+// in the real TCP input buffer; no kernel packet-coalescing assumption is needed.
+func TestBufferedTCPInputSASLTransition(t *testing.T) {
+	for _, test := range []struct {
+		mechanism  string
+		protection string
+	}{
+		{mechanism: "DIGEST-MD5", protection: "auth-int"},
+		{mechanism: "DIGEST-MD5", protection: saslDigestMD5RC4Cipher},
+		{mechanism: "DIGEST-MD5", protection: saslDigestMD53DESCipher},
+		{mechanism: "GSSAPI", protection: "auth-int"},
+		{mechanism: "GSSAPI", protection: "auth-conf"},
+	} {
+		t.Run(test.mechanism+"/"+test.protection, func(t *testing.T) {
+			for _, boundary := range []string{"two_frames_prefetched", "split_frame_header"} {
+				t.Run(boundary, func(t *testing.T) {
+					wire := &syncConsumerSecurityTestConn{}
+					sender := tcpInputSASLLayer(t, wire, test.mechanism, test.protection, false)
+					messages := []ldapwire.Message{
+						tcpInputSASLCompare(2, 7),
+						tcpInputSASLCompare(3, 13),
+						tcpInputSASLCompare(4, 1600),
+					}
+					var frames [][]byte
+					var stream []byte
+					for _, message := range messages {
+						frame := tcpInputSASLFrame(t, sender, wire, message)
+						frames = append(frames, frame)
+						stream = append(stream, frame...)
+					}
+					prefetched := len(frames[0]) + len(frames[1])
+					if boundary == "split_frame_header" {
+						prefetched = 2
+					}
+					raw, peer := tcpInputSASLPending(t, test.mechanism, stream[:prefetched])
+					receiver := tcpInputSASLLayer(t, raw, test.mechanism, test.protection, true)
+					if err := tcpInputWriteChunks(peer, stream[prefetched:], 37); err != nil {
+						t.Fatal(err)
+					}
+					if err := peer.CloseWrite(); err != nil {
+						t.Fatal(err)
+					}
+					var retained []ldapwire.Message
+					for index, want := range messages {
+						got, err := ldapwire.ReadMessage(receiver, 0)
+						if err != nil {
+							t.Fatalf("protected message %d: %v", want.ID, err)
+						}
+						if !bytes.Equal(tcpInputEncode(t, got), tcpInputEncode(t, want)) {
+							t.Fatalf("protected message %d changed", want.ID)
+						}
+						retained = append(retained, got)
+						if index == 0 && boundary == "two_frames_prefetched" &&
+							!bytes.Equal(raw.buffer[raw.start:raw.end], frames[1]) {
+							t.Fatal("first protected read consumed or changed the next prefetched frame")
+						}
+					}
+					if _, err := ldapwire.ReadMessage(receiver, 0); !errors.Is(err, io.EOF) {
+						t.Fatalf("after protected messages: %v, want EOF", err)
+					}
+					if err := receiver.Close(); err != nil {
+						t.Fatal(err)
+					}
+					for index, got := range retained {
+						if !bytes.Equal(tcpInputEncode(t, got), tcpInputEncode(t, messages[index])) {
+							t.Fatalf("message %d aliases reused or cleared frame storage", got.ID)
+						}
+					}
+				})
+			}
+
+			for _, failure := range []string{"tamper", "replay", "invalid_length", "plaintext"} {
+				t.Run(failure, func(t *testing.T) {
+					wire := &syncConsumerSecurityTestConn{}
+					sender := tcpInputSASLLayer(t, wire, test.mechanism, test.protection, false)
+					message := tcpInputSASLCompare(2, 7)
+					frame := tcpInputSASLFrame(t, sender, wire, message)
+					var stream []byte
+					wantErr := errSASLDigestMD5SecurityFrame
+					switch failure {
+					case "tamper":
+						// In DIGEST this hits the MAC or ciphertext, leaving the
+						// type/sequence trailer intact; in GSSAPI it hits the body.
+						frame[len(frame)-7] ^= 0x80
+						wantErr = errSASLDigestMD5Integrity
+					case "replay":
+						stream = append(stream, frame...)
+						wantErr = errSASLDigestMD5Sequence
+					case "invalid_length":
+						frame = []byte{0, 0, 0, 0}
+					case "plaintext":
+						frame = tcpInputEncode(t, message)
+					}
+					stream = append(stream, frame...)
+					// A valid unprotected PDU must never become dispatchable after
+					// the failed frame, including on subsequent decoder calls.
+					stream = append(stream, tcpInputEncode(t, tcpInputSASLCompare(99, 13))...)
+					raw, peer := tcpInputSASLPending(t, test.mechanism, stream)
+					receiver := tcpInputSASLLayer(t, raw, test.mechanism, test.protection, true)
+					if err := peer.CloseWrite(); err != nil {
+						t.Fatal(err)
+					}
+					if failure == "replay" {
+						got, err := ldapwire.ReadMessage(receiver, 0)
+						if err != nil || !bytes.Equal(tcpInputEncode(t, got), tcpInputEncode(t, message)) {
+							t.Fatalf("original frame before replay: %#v, %v", got, err)
+						}
+					}
+					output := bytes.Repeat([]byte{0xa5}, 256)
+					unchanged := bytes.Clone(output)
+					n, readErr := receiver.Read(output)
+					if n != 0 || readErr == nil || !bytes.Equal(output, unchanged) {
+						t.Fatalf("failed protected Read = (%d, %v), want no plaintext or buffer mutation", n, readErr)
+					}
+					if test.mechanism == "DIGEST-MD5" && !errors.Is(readErr, wantErr) {
+						t.Fatalf("protected Read error = %v, want %v", readErr, wantErr)
+					}
+					if _, ok := errors.AsType[net.Error](readErr); ok ||
+						errors.Is(readErr, io.EOF) || errors.Is(readErr, io.ErrUnexpectedEOF) {
+						t.Fatalf("transport failure masked protected-frame rejection: %v", readErr)
+					}
+					start, end := raw.start, raw.end
+					pending := bytes.Clone(raw.buffer[start:end])
+					if len(pending) == 0 {
+						t.Fatal("failed frame consumed the trailing plaintext PDU")
+					}
+					for range 2 {
+						got, err := ldapwire.ReadMessage(receiver, 0)
+						if !errors.Is(err, readErr) || got.Request != nil || got.ID != 0 {
+							t.Fatalf("decoder after failed frame = (%#v, %v), want no dispatchable request", got, err)
+						}
+						if raw.start != start || raw.end != end || !bytes.Equal(raw.buffer[start:end], pending) {
+							t.Fatal("security failure resumed consuming prefetched input")
+						}
+					}
+				})
+			}
+		})
+	}
+}
+
+func tcpInputSASLCompare(id int64, size int) ldapwire.Message {
+	return ldapwire.Message{ID: id, Request: ldapwire.CompareRequest{
+		DN: "cn=tcp-input", Attribute: "description", Assertion: bytes.Repeat([]byte{byte(id)}, size),
+	}}
+}
+
+func tcpInputSASLFrame(t *testing.T, sender net.Conn, wire *syncConsumerSecurityTestConn, message ldapwire.Message) []byte {
+	t.Helper()
+	wire.written.Reset()
+	plaintext := tcpInputEncode(t, message)
+	if n, err := sender.Write(plaintext); n != len(plaintext) || err != nil {
+		t.Fatalf("protect message %d = (%d, %v)", message.ID, n, err)
+	}
+	return bytes.Clone(wire.written.Bytes())
+}
+
+func tcpInputSASLPending(t *testing.T, mechanism string, protected []byte) (*bufferedTCPConnection, *net.TCPConn) {
+	t.Helper()
+	finalBind := tcpInputEncode(t, ldapwire.Message{ID: 1, Request: ldapwire.BindRequest{
+		Version: 3,
+		Authentication: ldapwire.Authentication{
+			IsSASL: true, SASLMechanism: mechanism,
+			HasSASLCredentials: true, SASLCredentials: []byte("synthetic final response"),
+		},
+	}})
+	stream := append(bytes.Clone(finalBind), protected...)
+	raw, peer := tcpInputPending(t, stream)
+	got, err := ldapwire.ReadMessage(raw, 0)
+	if err != nil {
+		t.Fatalf("read final SASL bind: %v", err)
+	}
+	if !bytes.Equal(tcpInputEncode(t, got), finalBind) {
+		t.Fatal("final SASL bind changed")
+	}
+	if raw.start != len(finalBind) || raw.end != len(stream) ||
+		!bytes.Equal(raw.buffer[raw.start:raw.end], protected) {
+		t.Fatal("protected bytes were not retained at the final-bind boundary")
+	}
+	t.Cleanup(func() {
+		if !bytes.Equal(tcpInputEncode(t, got), finalBind) {
+			t.Error("final SASL bind aliases reused or cleared TCP storage")
+		}
+	})
+	return raw, peer
+}
+
+func tcpInputSASLLayer(t *testing.T, raw net.Conn, mechanism, protection string, acceptor bool) net.Conn {
+	t.Helper()
+	const maximum = saslDigestMD5DefaultMaxBuffer
+	var layer net.Conn
+	var err error
+	if mechanism == "GSSAPI" {
+		// Reuse the existing AES key fixture; neither wrapper requires a KDC.
+		state := saslkrb5.SecurityState{SendSequence: 41, ReceiveSequence: 73}
+		if acceptor {
+			state.SendSequence, state.ReceiveSequence = state.ReceiveSequence, state.SendSequence
+		}
+		if protection == "auth-int" {
+			layer, err = saslkrb5.NewIntegrityConnection(raw, ldapBackendGSSAPITestKey(), acceptor, state, maximum, maximum)
+		} else {
+			layer, err = saslkrb5.NewConfidentialityConnection(raw, ldapBackendGSSAPITestKey(), acceptor, state, maximum, maximum)
+		}
+	} else {
+		key := []byte("0123456789abcdef")
+		defer clear(key)
+		cipher := availableSASLDigestMD5Ciphers(0, saslDigestMD5RC4SSF)[protection]
+		if protection == "auth-int" {
+			if acceptor {
+				layer, err = newSASLDigestMD5ServerIntegrityConnection(raw, key, maximum, maximum)
+			} else {
+				layer, err = newSASLDigestMD5IntegrityConnection(raw,
+					saslDigestMD5SigningClientServer, saslDigestMD5SigningServerClient, key, maximum, maximum)
+			}
+		} else if acceptor {
+			layer, err = newSASLDigestMD5ServerPrivacyConnection(raw, key, cipher, maximum, maximum)
+		} else {
+			layer, err = newSASLDigestMD5PrivacyConnection(raw,
+				saslDigestMD5SigningClientServer, saslDigestMD5SigningServerClient,
+				saslDigestMD5SealingClientServer, saslDigestMD5SealingServerClient, key, cipher, maximum, maximum)
+		}
+	}
+	if err != nil {
+		t.Fatalf("create %s/%s layer: %v", mechanism, protection, err)
+	}
+	t.Cleanup(func() { layer.Close() })
+	return layer
+}
diff --git a/internal/server/tcp_input_test.go b/internal/server/tcp_input_test.go
new file mode 100644
index 0000000..c55388b
--- /dev/null
+++ b/internal/server/tcp_input_test.go
@@ -0,0 +1,734 @@
+package server
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/wangle201210/ldap-go/internal/ldapwire"
+)
+
+const tcpInputTestTimeout = 5 * time.Second
+
+func TestBufferedTCPInputFraming(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		sizes     [2]int
+		chunkSize int
+	}{
+		{name: "short", sizes: [2]int{7, 13}},
+		{name: "long", sizes: [2]int{180, 250}},
+		{name: "fragmented", sizes: [2]int{180, 7}, chunkSize: 1},
+		{name: "larger_than_buffer", sizes: [2]int{1600, 2700}},
+		{name: "fragmented_large", sizes: [2]int{2700, 13}, chunkSize: 37},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			connection, peer := tcpInputPair(t, true)
+			first := tcpInputBindMessage(1, test.sizes[0])
+			second := tcpInputBindMessage(2, test.sizes[1])
+			stream := append(tcpInputEncode(t, first), tcpInputEncode(t, second)...)
+			consumed := make(chan int, 1)
+			var reader io.Reader = connection
+			if test.chunkSize > 0 {
+				reader = tcpInputReaderFunc(func(buffer []byte) (int, error) {
+					n, err := connection.Read(buffer)
+					if n > 0 {
+						select {
+						case consumed <- n:
+						case <-t.Context().Done():
+						}
+					}
+					return n, err
+				})
+			}
+			write := func() error {
+				if test.chunkSize == 0 {
+					return tcpInputWriteChunks(peer, stream, 0)
+				}
+				for len(stream) > 0 {
+					chunk := stream[:min(test.chunkSize, len(stream))]
+					if err := tcpInputWriteChunks(peer, chunk, 0); err != nil {
+						return err
+					}
+					// Wait for delivery before sending the next fragment, allowing
+					// any number of native reads to consume the current fragment.
+					for remaining := len(chunk); remaining > 0; {
+						select {
+						case n := <-consumed:
+							remaining -= n
+						case <-t.Context().Done():
+							return t.Context().Err()
+						}
+					}
+					stream = stream[len(chunk):]
+				}
+				return nil
+			}
+			written := make(chan error, 1)
+			go func() {
+				written <- errors.Join(write(), peer.CloseWrite())
+			}()
+			for _, want := range []ldapwire.Message{first, second} {
+				got, err := ldapwire.ReadMessage(reader, 0)
+				if err != nil {
+					t.Fatalf("ReadMessage(%d): %v", want.ID, err)
+				}
+				tcpInputAssertMessage(t, got, want)
+			}
+			if _, err := ldapwire.ReadMessage(reader, 0); !errors.Is(err, io.EOF) {
+				t.Fatalf("after two PDUs: %v, want EOF", err)
+			}
+			if err := tcpInputAwait(t, written); err != nil {
+				t.Fatalf("write PDUs: %v", err)
+			}
+		})
+	}
+}
+
+func TestBufferedTCPInputTruncatedPDU(t *testing.T) {
+	for _, test := range []struct {
+		name string
+		size int
+		keep int
+	}{
+		{name: "short_header", size: 7, keep: 1},
+		{name: "long_length", size: 1600, keep: 3},
+		{name: "short_body", size: 7, keep: -1},
+		{name: "body_beyond_buffer", size: 2700, keep: 1300},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			connection, peer := tcpInputPair(t, true)
+			first := tcpInputBindMessage(1, 7)
+			truncated := tcpInputEncode(t, tcpInputBindMessage(2, test.size))
+			keep := test.keep
+			if keep < 0 {
+				keep += len(truncated)
+			}
+			stream := append(tcpInputEncode(t, first), truncated[:keep]...)
+			if err := tcpInputWriteChunks(peer, stream, 31); err != nil {
+				t.Fatal(err)
+			}
+			if err := peer.CloseWrite(); err != nil {
+				t.Fatal(err)
+			}
+			got, err := ldapwire.ReadMessage(connection, 0)
+			if err != nil {
+				t.Fatalf("first PDU: %v", err)
+			}
+			tcpInputAssertMessage(t, got, first)
+			if _, err := ldapwire.ReadMessage(connection, 0); !errors.Is(err, io.ErrUnexpectedEOF) {
+				t.Fatalf("truncated PDU: %v, want unexpected EOF", err)
+			}
+		})
+	}
+}
+
+func TestBufferedTCPInputRawWrite(t *testing.T) {
+	connection, peer := tcpInputPair(t, true)
+	if connection.LocalAddr().String() != peer.RemoteAddr().String() ||
+		connection.RemoteAddr().String() != peer.LocalAddr().String() {
+		t.Fatal("connection addresses do not match the TCP peer")
+	}
+	if err := connection.SetReadDeadline(time.Now().Add(-time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	// No flush or read on the wrapped connection may be necessary for a write.
+	for _, payload := range [][]byte{{0, 0xff, 0x30, 0x80}, bytes.Repeat([]byte{0x00, 0xff, 0x7f}, 513)} {
+		if n, err := connection.Write(payload); n != len(payload) || err != nil {
+			t.Fatalf("Write = (%d, %v), want (%d, nil)", n, err, len(payload))
+		}
+		got := make([]byte, len(payload))
+		if _, err := io.ReadFull(peer, got); err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(got, payload) {
+			t.Fatal("raw write changed payload")
+		}
+	}
+	if err := connection.SetWriteDeadline(time.Now().Add(-time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	n, err := connection.Write([]byte{1})
+	if n != 0 || !errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatalf("expired Write = (%d, %v), want (0, deadline exceeded)", n, err)
+	}
+	if err := connection.SetWriteDeadline(time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := connection.Write([]byte{2}); n != 1 || err != nil {
+		t.Fatalf("Write after clearing deadline = (%d, %v)", n, err)
+	}
+	var got [1]byte
+	if _, err := io.ReadFull(peer, got[:]); err != nil || got[0] != 2 {
+		t.Fatalf("peer read after clearing deadline = (%x, %v)", got, err)
+	}
+}
+
+func TestBufferedTCPInputPendingDeadline(t *testing.T) {
+	for _, method := range []string{"SetReadDeadline", "SetDeadline"} {
+		for _, expiry := range []string{"past", "elapses"} {
+			for _, recovery := range []string{"extend", "clear"} {
+				t.Run(method+"/"+expiry+"/"+recovery, func(t *testing.T) {
+					payload := []byte("pending TCP input")
+					connection, peer := tcpInputPending(t, payload)
+					setDeadline := connection.SetReadDeadline
+					if method == "SetDeadline" {
+						setDeadline = connection.SetDeadline
+					}
+					deadline := time.Now().Add(-time.Second)
+					if expiry == "elapses" {
+						deadline = time.Now().Add(20 * time.Millisecond)
+					}
+					if err := setDeadline(deadline); err != nil {
+						t.Fatal(err)
+					}
+					if expiry == "elapses" {
+						<-time.After(time.Until(deadline))
+					}
+					for range 2 {
+						var buffer [1]byte
+						n, err := connection.Read(buffer[:])
+						timeout, ok := errors.AsType[net.Error](err)
+						if n != 0 || !errors.Is(err, os.ErrDeadlineExceeded) || !ok || !timeout.Timeout() {
+							t.Fatalf("Read with pending data after expiry = (%d, %v), want timeout", n, err)
+						}
+					}
+					if method == "SetDeadline" {
+						if n, err := connection.Write([]byte{1}); n != 0 || !errors.Is(err, os.ErrDeadlineExceeded) {
+							t.Fatalf("Write after SetDeadline expiry = (%d, %v)", n, err)
+						}
+					}
+					deadline = time.Time{}
+					if recovery == "extend" {
+						deadline = time.Now().Add(tcpInputTestTimeout)
+					}
+					if err := setDeadline(deadline); err != nil {
+						t.Fatal(err)
+					}
+					got := make([]byte, len(payload))
+					if _, err := io.ReadFull(connection, got); err != nil {
+						t.Fatalf("Read after deadline recovery: %v", err)
+					}
+					if !bytes.Equal(got, payload) {
+						t.Fatalf("deadline expiry consumed pending input: %q, want %q", got, payload)
+					}
+					// Recovery must reach the native socket once the pending buffer drains.
+					if err := tcpInputWriteChunks(peer, payload, 3); err != nil {
+						t.Fatal(err)
+					}
+					if _, err := io.ReadFull(connection, got); err != nil || !bytes.Equal(got, payload) {
+						t.Fatalf("refill after deadline recovery = (%q, %v)", got, err)
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestBufferedTCPInputWriteDeadlineKeepsPendingInputReadable(t *testing.T) {
+	payload := []byte("readable")
+	connection, _ := tcpInputPending(t, payload)
+	if err := connection.SetWriteDeadline(time.Now().Add(-time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	got := make([]byte, len(payload))
+	if _, err := io.ReadFull(connection, got); err != nil || !bytes.Equal(got, payload) {
+		t.Fatalf("Read with expired write deadline = (%q, %v)", got, err)
+	}
+}
+
