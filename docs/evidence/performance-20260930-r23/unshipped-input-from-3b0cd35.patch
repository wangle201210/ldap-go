+func tcpInputPair(t *testing.T, buffered bool) (net.Conn, *net.TCPConn) {
+	t.Helper()
+	listener := tcpInputListener(t)
+	var acceptor net.Listener = listener
+	if buffered {
+		acceptor = BufferedTCPListener(listener)
+	}
+	peer, err := net.DialTimeout("tcp4", listener.Addr().String(), tcpInputTestTimeout)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { peer.Close() })
+	connection, err := acceptor.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// This independent bound survives tests that clear the socket deadlines.
+	guard := time.AfterFunc(tcpInputTestTimeout, func() { peer.Close() })
+	t.Cleanup(func() {
+		guard.Stop()
+		peer.Close()
+		connection.Close()
+	})
+	for _, conn := range []net.Conn{connection, peer} {
+		if err := conn.SetDeadline(time.Now().Add(tcpInputTestTimeout)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if buffered {
+		if _, ok := connection.(*bufferedTCPConnection); !ok {
+			t.Fatalf("Accept returned %T, want *bufferedTCPConnection", connection)
+		}
+	}
+	return connection, peer.(*net.TCPConn)
+}
+
+func tcpInputPending(t *testing.T, payload []byte) (*bufferedTCPConnection, *net.TCPConn) {
+	t.Helper()
+	connection, peer := tcpInputPair(t, true)
+	buffered := connection.(*bufferedTCPConnection)
+	if len(buffered.buffer) != 1024 {
+		t.Fatalf("input buffer size = %d, want 1024", len(buffered.buffer))
+	}
+	if len(payload) == 0 || len(payload) > len(buffered.buffer) {
+		t.Fatal("invalid pending-input fixture size")
+	}
+	if err := tcpInputWriteChunks(peer, payload, 3); err != nil {
+		t.Fatal(err)
+	}
+	// Set up pending input from a real socket without assuming a single kernel
+	// read fills the buffer. No other goroutine owns the connection at this point.
+	if _, err := io.ReadFull(buffered.tcp, buffered.buffer[:len(payload)]); err != nil {
+		t.Fatal(err)
+	}
+	buffered.start, buffered.end = 0, len(payload)
+	return buffered, peer
+}
