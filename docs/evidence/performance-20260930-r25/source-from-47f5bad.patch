+								t.Fatalf("unexpected wrapper traversal order: %v", trace)
+							}
+							lease.Release()
+							if lease.source != tx {
+								t.Fatal("Release lost same-View authorization")
+							}
+							if _, err := GetReadOnly(scoped, dn, &lease); err != nil || lease.decoder == nil {
+								t.Fatalf("source-bound reuse failed: %v", err)
+							}
+						}
+					}
+				})
+			}
+			return nil
+		})
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.Update(t.Context(), func(writer Writer) error {
+		lease := NewEntryReadLease(writer)
+		if lease.source != nil || lease.decoder != nil {
+			t.Fatal("factory authorized a writable transaction")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
