diff --git a/internal/storage/entry_read_lease.go b/internal/storage/entry_read_lease.go
new file mode 100644
index 0000000..01c45d9
--- /dev/null
+++ b/internal/storage/entry_read_lease.go
@@ -0,0 +1,82 @@
+package storage
+
+import "github.com/wangle201210/ldap-go/internal/directory"
+
+// EntryReadLease pins the descriptors and Bolt payloads of one read-only entry.
+// Its zero value is ready for use. Do not copy or use a lease concurrently.
+// Release it before the enclosing Store.View callback returns, including on
+// errors and panics. A lease can be reused after Release.
+type EntryReadLease struct {
+	source  *boltTx
+	decoder *readOnlyCandidateDecoder
+}
+
+// NewEntryReadLease authorizes borrowing from source through a caller-approved
+// wrapper chain. It accepts only a concrete read-only Bolt reader, without
+// unwrapping decorators or acquiring a decoder. Other readers produce a zero
+// lease. The caller must establish that the original scoped reader and source
+// belong to the same View and that its wrappers permit read-only entry use.
+// GetReadOnly still traverses the original reader's normalization, migration
+// and getter dispatch; it borrows only if that dispatch reaches this source.
+// A source-bound lease must not outlive its View, even after Release.
+func NewEntryReadLease(source Reader) EntryReadLease {
+	if tx, ok := source.(*boltTx); ok && tx != nil && tx.tx != nil && !tx.tx.Writable() {
+		return EntryReadLease{source: tx}
+	}
+	return EntryReadLease{}
+}
+
+// Release invalidates borrowed entry descriptors and values. It is idempotent;
+// owned copies, DN strings and attribute descriptions remain valid. A source
+// binding remains available for reuse within the same View.
+func (lease *EntryReadLease) Release() {
+	if lease == nil || lease.decoder == nil {
+		return
+	}
+	decoder := lease.decoder
+	lease.decoder = nil
+	releaseReadOnlyCandidateDecoder(decoder)
+}
+
+// GetReadOnly has reader.Get's normalization, lookup and error semantics, but
+// the returned entry must not be mutated or retained beyond lease.Release or
+// the current Store.View callback. Clone or Select inside that lifetime to
+// obtain owned data. It does not validate display DNs or add identity hints.
+//
+// A zero lease borrows only from an undecorated read-only Bolt transaction in a
+// schema-aware partition. NewEntryReadLease also permits caller-approved wrappers
+// around its exact source. Both require the existing IndexEntryValuesReadOnly
+// schema opt-in. Binary rows smaller than 8 KiB, unsupported shapes, unapproved
+// custom readers/normalizers and legacy lookups use owned decoding. An active
+// or nil lease also uses the original owned path, without invalidating an
+// earlier borrowed entry.
+// Reader.Get itself always retains its existing owned-entry contract.
+func GetReadOnly(reader Reader, dn directory.DN, lease *EntryReadLease) (directory.Entry, error) {
+	return GetReadOnlyWithCheck(reader, dn, lease, nil)
+}
+
+// GetReadOnlyWithCheck additionally requires check to allow borrowing. It runs
+// synchronously after a large binary row is found and before decoder acquisition;
+// it is never retained. A false result keeps owned decoding and its errors.
+// The check must not mutate the reader, lease or policy. Source and normalizer
+// eligibility must already hold, independently of this deferred check.
+func GetReadOnlyWithCheck(reader Reader, dn directory.DN, lease *EntryReadLease, check func() bool) (directory.Entry, error) {
+	if lease == nil || lease.decoder != nil {
+		return reader.Get(dn)
+	}
+	scoped, ok := reader.(schemaAwarePartitionReader)
+	if !ok {
+		return reader.Get(dn)
+	}
+	if lease.source == nil {
+		tx, ok := scoped.Reader.(*boltTx)
+		if !ok || tx == nil || tx.tx == nil || tx.tx.Writable() {
+			return reader.Get(dn)
+		}
+	}
+	readOnly, ok := scoped.normalizer.(readOnlyIndexEntryValues)
+	if !ok || !readOnly.IndexEntryValuesReadOnly() {
+		return reader.Get(dn)
+	}
+	return scoped.get(dn, lease, check)
+}
