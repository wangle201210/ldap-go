+func assertEntryReadEqual(t *testing.T, got directory.Entry, err error, want directory.Entry, wantErr error) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) || reflect.TypeOf(err) != reflect.TypeOf(wantErr) || fmt.Sprint(err) != fmt.Sprint(wantErr) {
+		t.Fatalf("entry/error differs: got %v, want %v; entries equal=%v", err, wantErr, reflect.DeepEqual(got, want))
+	}
+	for _, sentinel := range []error{ErrEntryNotFound, ErrEntryAmbiguous, ErrDNIdentityMigrationRequired, context.Canceled} {
+		if errors.Is(err, sentinel) != errors.Is(wantErr, sentinel) {
+			t.Fatalf("error identity differs for %v", sentinel)
+		}
+	}
+}
