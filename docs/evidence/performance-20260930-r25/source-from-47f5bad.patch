@@ -0,0 +1,68 @@
+package storage
+
+import (
+	"fmt"
+	"testing"
+)
+
+// One static read transaction isolates Get and lease costs from fixture setup,
+// View construction, context creation, writes, server wrappers and sockets.
+func BenchmarkBoltDirectGetReadOnly(b *testing.B) {
+	for _, members := range []int{10, 1000} {
+		b.Run(fmt.Sprintf("Members=%d", members), func(b *testing.B) {
+			store, schema, dn := newEntryReadFixture(b, members, "v3")
+			ctx := b.Context()
+			for _, readonly := range []bool{false, true} {
+				name := "Owned"
+				if readonly {
+					name = "ReadOnly"
+				}
+				b.Run(name, func(b *testing.B) {
+					if err := store.View(ctx, func(reader Reader) error {
+						scoped := ReaderInPartitionWithNormalizer(reader, "db", schema)
+						want, err := scoped.Get(dn)
+						if err != nil {
+							return err
+						}
+						memberIndex := len(want.Attributes) - 1
+						if len(want.Attributes[memberIndex].Values) != members {
+							b.Fatal("unexpected member count")
+						}
+						// Warm decoder recycling before timing; allocation on a cold
+						// pool remains covered by the ownership tests, not this loop.
+						var warm EntryReadLease
+						if readonly {
+							if _, err := GetReadOnly(scoped, dn, &warm); err != nil {
+								warm.Release()
+								return err
+							}
+							warm.Release()
+						}
+						b.ReportAllocs()
+						if readonly {
+							for b.Loop() {
+								var lease EntryReadLease
+								entry, err := GetReadOnly(scoped, dn, &lease)
+								valid := err == nil && len(entry.Attributes[memberIndex].Values) == members
+								lease.Release()
+								if !valid {
+									b.Fatalf("GetReadOnly result changed: %v", err)
+								}
+							}
+						} else {
+							for b.Loop() {
+								entry, err := scoped.Get(dn)
+								if err != nil || len(entry.Attributes[memberIndex].Values) != members {
+									b.Fatalf("Get result changed: %v", err)
+								}
+							}
+						}
+						return nil
+					}); err != nil {
+						b.Fatal(err)
+					}
+				})
+			}
+		})
+	}
+}
diff --git a/internal/storage/entry_read_lease_check_test.go b/internal/storage/entry_read_lease_check_test.go
