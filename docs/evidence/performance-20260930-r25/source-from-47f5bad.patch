+func TestGetReadOnlyActiveLeaseAndPanic(t *testing.T) {
+	var nilLease *EntryReadLease
+	nilLease.Release()
+	holdIdleReadOnlyCandidateDecoders(t)
+	store, schema, dn := newEntryReadFixture(t, 1000, "v3")
+	secondDN, err := directory.ParseDN("uid=user000001,dc=example")
+	if err != nil {
+		t.Fatal(err)
+	}
+	key := entryReadKey(t, schema, secondDN)
+	if err := store.View(t.Context(), func(reader Reader) error {
+		scoped := ReaderInPartitionWithNormalizer(reader, "db", schema)
+		var firstLease, nestedLease EntryReadLease
+		defer firstLease.Release()
+		defer nestedLease.Release()
+		first, err := GetReadOnly(scoped, dn, &firstLease)
+		if err != nil {
+			return err
+		}
+		want := first.Clone()
+		decoder := firstLease.decoder
+		if decoder == nil {
+			t.Fatal("large fixture did not borrow")
+		}
+		second, err := GetReadOnly(scoped, secondDN, &firstLease)
+		if err != nil {
+			return err
+		}
+		if entryReadBorrows(second, reader.(*boltTx).entries.Get(key)) || firstLease.decoder != decoder {
+			t.Fatal("active lease was overwritten or a second entry borrowed")
+		}
+		missing, err := directory.ParseDN("uid=missing,dc=example")
+		if err != nil {
+			return err
+		}
+		if _, err := GetReadOnly(scoped, missing, &firstLease); !errors.Is(err, ErrEntryNotFound) || firstLease.decoder != decoder {
+			t.Fatalf("failed nested lookup changed active lease: %v", err)
+		}
+		if _, err := GetReadOnly(scoped, secondDN, &nestedLease); err != nil {
+			return err
+		}
+		if nestedLease.decoder == nil || nestedLease.decoder == decoder {
+			t.Fatal("nested lease does not have an exclusive decoder")
+		}
+		nestedLease.Release()
+		if _, err := scoped.Get(secondDN); err != nil {
+			return err
+		}
+		if !reflect.DeepEqual(first, want) {
+			t.Fatal("nested reads changed the active entry")
+		}
+		firstLease.Release()
+		poolSize := len(idleReadOnlyCandidateDecoders)
+		firstLease.Release()
+		if len(idleReadOnlyCandidateDecoders) != poolSize {
+			t.Fatal("decoder released twice")
+		}
+		panicValue := errors.New("consumer panic")
+		var panicLease EntryReadLease
+		var panicDecoder *readOnlyCandidateDecoder
+		func() {
+			defer func() {
+				if recovered := recover(); recovered != panicValue {
+					t.Fatalf("recovered %v, want consumer panic", recovered)
+				}
+			}()
+			defer panicLease.Release()
+			if _, err := GetReadOnly(scoped, dn, &panicLease); err != nil {
+				t.Fatal(err)
+			}
+			panicDecoder = panicLease.decoder
+			panic(panicValue)
+		}()
+		if panicLease.decoder != nil || panicDecoder == nil {
+			t.Fatal("panic cleanup did not release the lease")
+		}
+		assertReadOnlyCandidateDecoderCleared(t, panicDecoder)
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
