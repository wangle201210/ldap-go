@@ -0,0 +1,49 @@
+package server
+
+import "github.com/wangle201210/ldap-go/internal/storage"
+
+func (server *Server) compareReadLeaseSource(
+	state *connectionState,
+	database *runtimeDatabase,
+	attribute string,
+	hasControls bool,
+	reader storage.Reader,
+) storage.Reader {
+	source := server.compareReadLeaseCandidate(state, database, attribute, hasControls, reader)
+	if source == nil || !compareReadLeaseAllowed(state, database, reader) {
+		return nil
+	}
+	return source
+}
+
+func compareReadLeaseAllowed(state *connectionState, database *runtimeDatabase, reader storage.Reader) bool {
+	return databaseSearchResultCacheSafe(state.runtime, *database) &&
+		smallIndexedRuntimeProjectionSafe(state.runtime) &&
+		localProjectionReadOnly(state.runtime, reader) && state.runtime.access.CanBatchValues()
+}
+
+func (server *Server) compareReadLeaseCandidate(
+	state *connectionState,
+	database *runtimeDatabase,
+	attribute string,
+	hasControls bool,
+	reader storage.Reader,
+) storage.Reader {
+	if attribute != "member" || database == nil || state.protocolVersion != 3 || hasControls ||
+		!databaseUsesRuntimeDNIdentity(*database, state.runtime.schema) ||
+		!plainBoltSearchStore(server.config.Store) {
+		return nil
+	}
+	// These server-owned wrappers only supply context/revision metadata. Keep
+	// the original reader for Get and ACL; the source authorizes its row lease.
+	for {
+		switch contextual := reader.(type) {
+		case storageRevisionReader:
+			reader = contextual.Reader
+		case accessContextReader:
+			reader = contextual.Reader
+		default:
+			return reader
+		}
+	}
+}
