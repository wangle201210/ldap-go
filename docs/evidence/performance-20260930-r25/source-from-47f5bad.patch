+func TestGetReadOnlyFormatsAndOwnership(t *testing.T) {
+	for _, format := range []string{"v1", "v2", "v3", "json"} {
+		for _, members := range []int{10, 1000} {
+			t.Run(fmt.Sprintf("%s/%d", format, members), func(t *testing.T) {
+				store, schema, dn := newEntryReadFixture(t, members, format)
+				key := entryReadKey(t, schema, dn)
+				var want, cloned, selected directory.Entry
+				var dnText string
+				var names []string
+				if err := store.View(t.Context(), func(reader Reader) error {
+					scoped := ReaderInPartitionWithNormalizer(reader, "db", schema)
+					var err error
+					want, err = scoped.Get(dn)
+					if err != nil {
+						return err
+					}
+					raw := reader.(*boltTx).entries.Get(key)
+					before := bytes.Clone(raw)
+					var lease EntryReadLease
+					defer lease.Release()
+					entry, err := GetReadOnly(scoped, dn, &lease)
+					assertEntryReadEqual(t, entry, err, want, nil)
+					borrowed := members == 1000 && format != "json"
+					if entryReadBorrows(entry, raw) != borrowed || (lease.decoder != nil) != borrowed || entryReadBorrows(want, raw) {
+						t.Fatalf("unexpected owned/borrowed result for %s/%d", format, members)
+					}
+					cloned = entry.Clone()
+					selected = entry.Select([]string{"member"}, false)
+					dnText = entry.DN
+					for _, attribute := range entry.Attributes {
+						names = append(names, attribute.Description)
+					}
+					decoder := lease.decoder
+					lease.Release()
+					lease.Release()
+					if decoder != nil {
+						assertReadOnlyCandidateDecoderCleared(t, decoder)
+					}
+					// Reuse after Release must not change owned output or strings.
+					if _, err := GetReadOnly(scoped, dn, &lease); err != nil {
+						return err
+					}
+					if !bytes.Equal(raw, before) {
+						t.Fatal("borrowing or release changed Bolt payloads")
+					}
+					return nil
+				}); err != nil {
+					t.Fatal(err)
+				}
+				if err := store.Close(); err != nil {
+					t.Fatal(err)
+				}
+				if !reflect.DeepEqual(cloned, want.Clone()) || !reflect.DeepEqual(selected, want.Select([]string{"member"}, false)) || dnText != want.DN {
+					t.Fatal("owned output changed after release and Bolt unmap")
+				}
+				for i, name := range names {
+					if name != want.Attributes[i].Description {
+						t.Fatal("attribute description did not remain owned")
+					}
+				}
+				selected.Attributes[0].Values[0][0] ^= 1
+				if !reflect.DeepEqual(cloned, want.Clone()) {
+					t.Fatal("independent owned outputs share mutable bytes")
+				}
+			})
+		}
+	}
+}
