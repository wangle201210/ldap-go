+								defer lease.Release()
+								if readonly {
+									entry, err = GetReadOnly(scoped, dn, &lease)
+									assertEntryReadEqual(t, entry, err, want, wantErr)
+									if !slices.Equal(trace, wantTrace) || errors.Is(err, failure) != errors.Is(wantErr, failure) {
+										t.Fatalf("cancel=%d: trace/error = %v/%v, want %v/%v", cancelAt, trace, err, wantTrace, wantErr)
+									}
+									if mode == "legacy" && lease.decoder != nil {
+										t.Fatal("legacy fallback borrowed an entry")
+									}
+									lease.Release()
+								} else {
+									entry, err = scoped.Get(dn)
+									want, wantErr, wantTrace = entry, err, slices.Clone(trace)
+									if normalizeFails && !slices.Equal(trace, []string{"normalize"}) {
+										t.Fatalf("normalizer failure reached storage: %v", trace)
+									}
+									if mode == "normal" && cancelAt == 0 && !normalizeFails && !slices.Equal(trace, []string{"normalize", "ctx", "ctx"}) {
+										t.Fatalf("direct Get checkpoints changed: %v", trace)
