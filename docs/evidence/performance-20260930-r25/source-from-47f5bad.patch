+func TestCompareReadLeaseGateFallback(t *testing.T) {
+	server, state := newSmallIndexedFixture(t, 0)
+	state.protocolVersion = 3
+	group := defaultProjectionBenchmarkEntry(true)
+	smallIndexedPut(t, server, state, group, false)
+	request := ldapwire.CompareRequest{DN: group.DN, Attribute: "member", Assertion: group.Values("member")[999]}
+	message := ldapwire.Message{ID: 17, Request: request}
+	checkCompareReadLeaseWire(t, server, state, message, ldapwire.ResultCompareTrue, true)
+	dn, err := parseCoreWriteDN(state.runtime, group.DN)
+	if err != nil {
+		t.Fatal(err)
+	}
+	database := databaseForNormalizedDN(state.runtime, dn)
+	store, normalizer := server.config.Store, database.dnNormalizer
+	for _, name := range []string{"custom store", "custom normalizer", "empty controls", "control", "LDAPv2", "other attribute"} {
+		t.Run(name, func(t *testing.T) {
+			defer func() {
+				server.config.Store, database.dnNormalizer, state.protocolVersion = store, normalizer, 3
+			}()
+			message, request := message, request
+			var calls []string
+			switch name {
+			case "custom store":
+				server.config.Store = &smallIndexedObservedStore{Store: store}
+			case "custom normalizer":
+				database.dnNormalizer = routingAttributeNormalizer(func(attribute string, value []byte) (string, []byte, error) {
+					calls = append(calls, attribute+"="+string(value))
+					return state.runtime.schema.NormalizeDNAttribute(attribute, value)
+				})
+			case "empty controls":
+				message.ControlsPresent = true
+			case "control":
+				message.Controls = []ldapwire.Control{{OID: manageDsaITControlOID, Critical: true}}
+			case "LDAPv2":
+				state.protocolVersion = 2
+			case "other attribute":
+				request.Attribute, request.Assertion = "cn", group.Values("cn")[0]
+			}
+			message.Request = request
+			if err := server.config.Store.View(t.Context(), func(reader storage.Reader) error {
+				if server.compareReadLeaseSource(state, database, request.Attribute, len(message.Controls) != 0 || message.ControlsPresent, reader) != nil || len(calls) != 0 {
+					t.Fatalf("fallback gate authorized borrowing or called custom normalizer: calls=%v", calls)
+				}
+				return nil
+			}); err != nil {
+				t.Fatal(err)
+			}
+			wire := compareReadLeaseWire(t, server, state, message, ldapwire.ResultCompareTrue)
+			if name == "custom normalizer" && len(calls) == 0 {
+				t.Fatal("fallback skipped custom normalization")
+			}
+			candidateCalls := slices.Clone(calls)
+			calls = nil
+			server.config.Store = &smallIndexedObservedStore{Store: server.config.Store}
+			ownedWire := compareReadLeaseWire(t, server, state, message, ldapwire.ResultCompareTrue)
+			if !bytes.Equal(wire, ownedWire) || !slices.Equal(candidateCalls, calls) {
+				t.Fatalf("fallback changed owned Get wire or callbacks: candidate=%v, owned=%v", candidateCalls, calls)
+			}
+		})
+	}
+	var trace string
+	observed := &smallIndexedObservedStore{Store: store,
+		beforeView: func() { trace += "view;" },
+		afterView: func() error {
+			trace += "return;"
+			return nil
+		},
+	}
+	server.config.Store = observed
+	defer func() { server.config.Store = store }()
+	writeErr := errors.New("compare write failed")
+	for _, failure := range []error{nil, writeErr} {
+		trace, observed.views, observed.updates = "", 0, 0
+		capture := &smallIndexedCapture{onWrite: func() { trace += "wire;" }, err: failure}
+		err := server.handleCompare(t.Context(), capture, state, message, request)
+		if !errors.Is(err, failure) || trace != "view;return;wire;" || observed.views != 1 || observed.updates != 0 {
+			t.Fatalf("error=%v, callbacks=%s, views=%d updates=%d", err, trace, observed.views, observed.updates)
+		}
+	}
+}
