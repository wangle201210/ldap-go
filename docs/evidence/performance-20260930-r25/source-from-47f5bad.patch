+package storage
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"slices"
+	"testing"
+
+	"github.com/wangle201210/ldap-go/internal/directory"
+)
+
+func TestGetReadOnlyWithCheckFormatsAndBounds(t *testing.T) {
+	holdIdleReadOnlyCandidateDecoders(t)
+	releaseReadOnlyCandidateDecoder(acquireReadOnlyCandidateDecoder())
+	store, schema, dn := newEntryReadFixture(t, 10, "v3")
+	key := entryReadKey(t, schema, dn)
+	entry := directory.Entry{DN: "not a valid DN", Attributes: []directory.Attribute{
+		{Description: "member", Values: [][]byte{bytes.Repeat([]byte("x"), 9000)}, RawNormalized: true},
+		{Description: "empty"},
+		{Description: "binary;lang-EN", Values: [][]byte{{}, {0, 255}}},
+	}}
+	type testCase struct {
+		name     string
+		encoded  []byte
+		calls    int
+		borrowed bool
+	}
+	var cases []testCase
+	for _, format := range []string{"v1", "v2", "v3", "json"} {
+		encoded := encodeCandidateTestEntry(t, entry, "unrelated identity", format)
+		calls := 0
+		if format != "json" {
+			calls = 1
+		}
+		cases = append(cases,
+			testCase{format, encoded, calls, calls == 1},
+			testCase{format + "/trailing", append(bytes.Clone(encoded), 0), calls, false},
+			testCase{format + "/truncated", bytes.Clone(encoded[:len(encoded)-1]), calls, false},
+		)
+	}
+	for _, size := range []int{8191, 8192, 8193} {
+		candidate := entry.Clone()
+		encoded := encodeCandidateTestEntry(t, candidate, "unrelated identity", "v3")
+		values := candidate.Attributes[0].Values
+		values[0] = values[0][:len(values[0])-(len(encoded)-size)]
+		encoded = encodeCandidateTestEntry(t, candidate, "unrelated identity", "v3")
+		if len(encoded) != size {
+			t.Fatalf("fixture size = %d, want %d", len(encoded), size)
+		}
+		calls := 0
+		if size >= 8192 {
+			calls = 1
+		}
+		cases = append(cases, testCase{fmt.Sprintf("bytes/%d", size), encoded, calls, calls == 1})
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			if err := store.Update(t.Context(), func(writer Writer) error {
+				return writer.(*boltTx).entries.Put(key, test.encoded)
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if err := store.View(t.Context(), func(reader Reader) error {
+				scoped := ReaderInPartitionWithNormalizer(reader, "db", schema)
+				want, wantErr := scoped.Get(dn)
+				raw := reader.(*boltTx).entries.Get(key)
+				before := bytes.Clone(raw)
+				for _, allow := range []bool{false, true} {
+					lease := NewEntryReadLease(reader)
+					defer lease.Release()
+					calls, idle := 0, len(idleReadOnlyCandidateDecoders)
+					got, err := GetReadOnlyWithCheck(scoped, dn, &lease, func() bool {
+						calls++
+						if lease.decoder != nil || len(idleReadOnlyCandidateDecoders) != idle {
+							t.Fatal("check ran after decoder acquisition")
+						}
+						return allow
+					})
+					assertEntryReadEqual(t, got, err, want, wantErr)
+					borrowed := allow && test.borrowed
+					if calls != test.calls || (lease.decoder != nil) != borrowed || entryReadBorrows(got, raw) != borrowed {
+						t.Fatalf("allow=%t: calls/borrowed = %d/%t, want %d/%t", allow, calls, lease.decoder != nil, test.calls, borrowed)
+					}
+					if _, hinted := got.DNIdentity(); hinted {
+						t.Fatal("checked Get added an identity hint")
+					}
+					lease.Release()
+					if len(idleReadOnlyCandidateDecoders) != idle || !bytes.Equal(raw, before) {
+						t.Fatal("checked Get leaked a decoder or changed the stored row")
+					}
+					if !allow {
+						assertEntryReadEqual(t, got, err, want, wantErr)
+					}
+				}
+				return nil
+			}); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestGetReadOnlyWithCheckErrorOrder(t *testing.T) {
+	for _, test := range []struct {
+		name           string
+		mode           string
+		cancelAt       int
+		normalizeFails bool
+		allowLegacy    bool
+		calls          int
+	}{
+		{name: "normal", calls: 1},
+		{name: "normalize-before-context-and-migration", mode: "bad-marker", cancelAt: 1, normalizeFails: true},
+		{name: "context-before-migration", mode: "bad-marker", cancelAt: 1},
+		{name: "context-before-row", cancelAt: 2},
+		{name: "missing", mode: "missing"},
+		{name: "context-before-missing", mode: "missing", cancelAt: 2},
+		{name: "context-before-decode", mode: "malformed", cancelAt: 2},
+		{name: "malformed", mode: "malformed", calls: 1},
+		{name: "bad-marker", mode: "bad-marker"},
+		// An absent marker with only schema-aware rows still permits direct Get.
+		{name: "missing-marker", mode: "missing-marker", calls: 1},
+		{name: "legacy-required", mode: "legacy"},
+		{name: "legacy-allowed", mode: "legacy", allowLegacy: true},
+		{name: "legacy-context", mode: "legacy", allowLegacy: true, cancelAt: 3},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			store, schema, dn := newEntryReadFixture(t, 1000, "v3")
+			key := entryReadKey(t, schema, dn)
+			if err := store.Update(t.Context(), func(writer Writer) error {
+				tx := writer.(*boltTx)
+				switch test.mode {
+				case "missing":
+					return tx.entries.Delete(key)
+				case "malformed":
+					return tx.entries.Put(key, append(bytes.Clone(tx.entries.Get(key)), 0))
+				case "bad-marker":
+					return tx.meta.Put(boltSchemaAwareDNMigrationMetadataKey("db"), []byte{99})
+				case "missing-marker", "legacy":
+					if err := tx.meta.Delete(boltSchemaAwareDNMigrationMetadataKey("db")); err != nil {
+						return err
+					}
+					if test.mode == "legacy" {
+						stored, err := decodeStoredEntry(tx.entries.Get(key))
+						if err != nil {
+							return err
+						}
+						encoded, err := encodeEntry(stored.Entry, "", "")
+						if err != nil {
+							return err
+						}
+						if err := tx.entries.Delete(key); err != nil {
+							return err
+						}
+						return tx.entries.Put([]byte(partitionedEntryKey("db", dn.Key())), encoded)
+					}
+				}
+				return nil
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if err := store.View(t.Context(), func(reader Reader) error {
+				tx := reader.(*boltTx)
+				original := tx.ctx
+				defer func() { tx.ctx = original }()
+				var trace []string
+				normalizer := entryReadTraceNormalizer{boltModifyReadOnlySchema: schema, trace: &trace}
+				failure := errors.New("normalizer failure")
+				if test.normalizeFails {
+					normalizer.failure = failure
+				}
+				scoped := schemaAwarePartitionReader{partitionReader: partitionReader{Reader: reader, partition: "db"}, normalizer: normalizer, allowLegacy: test.allowLegacy}
+				tx.ctx = &entryReadTraceContext{Context: original, trace: &trace, cancelAt: test.cancelAt}
+				want, wantErr := scoped.Get(dn)
+				wantTrace := slices.Clone(trace)
+				for _, allow := range []bool{false, true} {
+					trace = nil
+					tx.ctx = &entryReadTraceContext{Context: original, trace: &trace, cancelAt: test.cancelAt}
+					lease := NewEntryReadLease(reader)
+					defer lease.Release()
+					calls := 0
+					got, err := GetReadOnlyWithCheck(scoped, dn, &lease, func() bool {
+						calls++
+						if lease.decoder != nil || !slices.Equal(trace, wantTrace) {
+							t.Fatalf("check preceded original Get checkpoints: %v, want %v", trace, wantTrace)
+						}
+						trace = append(trace, "check")
+						return allow
+					})
+					assertEntryReadEqual(t, got, err, want, wantErr)
+					expected := slices.Clone(wantTrace)
+					if test.calls != 0 {
+						expected = append(expected, "check")
+					}
+					if calls != test.calls || !slices.Equal(trace, expected) || errors.Is(err, failure) != errors.Is(wantErr, failure) {
+						t.Fatalf("allow=%t: calls/trace/error = %d/%v/%v, want %d/%v/%v", allow, calls, trace, err, test.calls, expected, wantErr)
+					}
+					if (!allow || test.calls == 0 || err != nil) && lease.decoder != nil {
+						t.Fatal("owned fallback retained a decoder")
+					}
+					lease.Release()
+					if calls != test.calls || !slices.Equal(trace, expected) {
+						t.Fatal("Release invoked callbacks")
+					}
+				}
+				return nil
+			}); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestGetReadOnlyWithCheckSourceDispatch(t *testing.T) {
+	store, schema, dn := newEntryReadFixture(t, 1000, "v3")
+	key := entryReadKey(t, schema, dn)
+	if err := store.View(t.Context(), func(reader Reader) error {
+		return store.View(t.Context(), func(other Reader) error {
+			for _, mode := range []string{"known-wrappers", "different-source", "different-source-direct", "unknown-source", "custom-getter", "nil-lease"} {
+				t.Run(mode, func(t *testing.T) {
+					var trace []string
+					var wrapped Reader = entryReadObservedReader{Reader: entryReadObservedReader{Reader: reader, trace: &trace}, trace: &trace}
+					if mode == "different-source-direct" {
+						wrapped = reader
+					} else if mode == "custom-getter" {
+						wrapped = entryReadObservedGetter{Reader: reader, trace: &trace}
+					}
+					scoped := ReaderInPartitionWithNormalizerLegacy(wrapped, "db", schema)
+					want, wantErr := scoped.Get(dn)
+					wantTrace := slices.Clone(trace)
+					trace = nil
+					source := reader
+					switch mode {
+					case "different-source", "different-source-direct":
+						source = other
+					case "unknown-source":
+						source = wrapped
+					}
+					lease := NewEntryReadLease(source)
+					defer lease.Release()
+					leasePointer := &lease
+					if mode == "nil-lease" {
+						leasePointer = nil
+					}
+					calls := 0
+					got, err := GetReadOnlyWithCheck(scoped, dn, leasePointer, func() bool {
+						calls++
+						if !slices.Equal(trace, wantTrace) {
+							t.Fatalf("check reordered getter dispatch: %v, want %v", trace, wantTrace)
+						}
+						return true
+					})
+					assertEntryReadEqual(t, got, err, want, wantErr)
+					wantCalls := 0
+					if mode == "known-wrappers" {
+						wantCalls = 1
+					}
+					borrowed := wantCalls == 1
+					if calls != wantCalls || !slices.Equal(trace, wantTrace) || (lease.decoder != nil) != borrowed || entryReadBorrows(got, reader.(*boltTx).entries.Get(key)) != borrowed {
+						t.Fatalf("calls/trace/borrowed = %d/%v/%t, want %d/%v/%t", calls, trace, lease.decoder != nil, wantCalls, wantTrace, borrowed)
+					}
+				})
+			}
+			return nil
+		})
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestGetReadOnlyWithCheckActiveLeaseAndReuse(t *testing.T) {
+	store, schema, dn := newEntryReadFixture(t, 1000, "v3")
+	secondDN, err := directory.ParseDN("uid=user000001,dc=example")
+	if err != nil {
+		t.Fatal(err)
+	}
+	missing, err := directory.ParseDN("uid=missing,dc=example")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := store.View(t.Context(), func(reader Reader) error {
+		scoped := ReaderInPartitionWithNormalizer(reader, "db", schema)
+		want, err := scoped.Get(dn)
+		if err != nil {
+			return err
+		}
+		lease := NewEntryReadLease(reader)
+		defer lease.Release()
+		allow, calls := true, 0
+		check := func() bool {
+			calls++
+			if lease.decoder != nil {
+				t.Fatal("check ran with an active lease")
+			}
+			return allow
+		}
+		for i, decision := range []bool{true, false, true} {
+			allow = decision
+			first, err := GetReadOnlyWithCheck(scoped, dn, &lease, check)
+			assertEntryReadEqual(t, first, err, want, nil)
+			if calls != i+1 || (lease.decoder != nil) != allow || entryReadBorrows(first, reader.(*boltTx).entries.Get(entryReadKey(t, schema, dn))) != allow {
+				t.Fatalf("reuse %d: calls/borrowed = %d/%t, want %d/%t", i, calls, lease.decoder != nil, i+1, allow)
+			}
+			decoder := lease.decoder
+			if i == 0 {
+				for _, nestedDN := range []directory.DN{secondDN, missing} {
+					nestedWant, nestedErr := scoped.Get(nestedDN)
+					got, err := GetReadOnlyWithCheck(scoped, nestedDN, &lease, check)
+					assertEntryReadEqual(t, got, err, nestedWant, nestedErr)
+					if calls != 1 || lease.decoder != decoder || entryReadBorrows(got, reader.(*boltTx).entries.Get(entryReadKey(t, schema, nestedDN))) {
+						t.Fatal("nested Get invoked check, borrowed, or overwrote the active lease")
+					}
+					assertEntryReadEqual(t, first, nil, want, nil)
+				}
+			}
+			lease.Release()
+			lease.Release()
+			if lease.decoder != nil || lease.source != reader.(*boltTx) || calls != i+1 {
+				t.Fatal("Release changed the binding, called check, or retained a decoder")
+			}
+			if decoder != nil {
+				assertReadOnlyCandidateDecoderCleared(t, decoder)
+			}
+		}
+		otherCalls := 0
+		got, err := GetReadOnlyWithCheck(scoped, dn, &lease, func() bool { otherCalls++; return false })
+		assertEntryReadEqual(t, got, err, want, nil)
+		if otherCalls != 1 || calls != 3 || lease.decoder != nil {
+			t.Fatal("Get reused a previous call's check")
+		}
+		for _, checked := range []bool{true, false} {
+			if checked {
+				got, err = GetReadOnlyWithCheck(scoped, dn, &lease, nil)
+			} else {
+				got, err = GetReadOnly(scoped, dn, &lease)
+			}
+			assertEntryReadEqual(t, got, err, want, nil)
+			if lease.decoder == nil || otherCalls != 1 || calls != 3 {
+				t.Fatal("nil check or GetReadOnly reused a previous call's policy")
+			}
+			lease.Release()
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestGetReadOnlyWithCheckPanicCleanup(t *testing.T) {
+	for _, mode := range []string{"check", "consumer"} {
+		t.Run(mode, func(t *testing.T) {
+			holdIdleReadOnlyCandidateDecoders(t)
+			releaseReadOnlyCandidateDecoder(acquireReadOnlyCandidateDecoder())
+			store, schema, dn := newEntryReadFixture(t, 1000, "v3")
+			if err := store.View(t.Context(), func(reader Reader) error {
+				scoped := ReaderInPartitionWithNormalizer(reader, "db", schema)
+				lease := NewEntryReadLease(reader)
+				defer lease.Release()
+				panicValue := errors.New(mode + " panic")
+				calls := 0
+				var decoder *readOnlyCandidateDecoder
+				func() {
+					defer func() {
+						if recovered := recover(); recovered != panicValue {
+							t.Fatalf("recovered %v, want %v", recovered, panicValue)
+						}
+					}()
+					defer lease.Release()
+					_, err := GetReadOnlyWithCheck(scoped, dn, &lease, func() bool {
+						calls++
+						if lease.decoder != nil || len(idleReadOnlyCandidateDecoders) != 1 {
+							t.Fatal("check ran after decoder acquisition")
+						}
+						if mode == "check" {
+							panic(panicValue)
+						}
+						return true
+					})
+					if err != nil {
+						t.Fatal(err)
+					}
+					decoder = lease.decoder
+					if mode == "consumer" {
+						panic(panicValue)
+					}
+				}()
+				if calls != 1 || lease.decoder != nil || len(idleReadOnlyCandidateDecoders) != 1 || (decoder != nil) != (mode == "consumer") {
+					t.Fatal("panic cleanup lost or retained a decoder, or skipped check")
+				}
+				if decoder != nil {
+					assertReadOnlyCandidateDecoderCleared(t, decoder)
+				}
+				want, wantErr := scoped.Get(dn)
+				got, err := GetReadOnlyWithCheck(scoped, dn, &lease, func() bool { calls++; return true })
+				assertEntryReadEqual(t, got, err, want, wantErr)
+				if calls != 2 || lease.decoder == nil {
+					t.Fatal("lease was not reusable after panic")
+				}
+				return nil
+			}); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
