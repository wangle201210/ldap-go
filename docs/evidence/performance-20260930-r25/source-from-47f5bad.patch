+					case "bad-marker":
+						return tx.meta.Put(boltSchemaAwareDNMigrationMetadataKey("db"), []byte{99})
+					case "missing-marker", "legacy":
+						if err := tx.meta.Delete(boltSchemaAwareDNMigrationMetadataKey("db")); err != nil {
+							return err
+						}
+						if mode == "legacy" {
+							stored, err := decodeStoredEntry(tx.entries.Get(key))
+							if err != nil {
+								return err
+							}
+							encoded, err := encodeEntry(stored.Entry, "", "")
+							if err != nil {
+								return err
+							}
+							if err := tx.entries.Delete(key); err != nil {
+								return err
+							}
+							return tx.entries.Put([]byte(partitionedEntryKey("db", dn.Key())), encoded)
+						}
+					}
+					return nil
+				}); err != nil {
+					t.Fatal(err)
+				}
+				for _, cancelAt := range []int{0, 1, 2, 3, 4} {
+					for _, normalizeFails := range []bool{false, true} {
+						if err := store.View(t.Context(), func(reader Reader) error {
+							tx := reader.(*boltTx)
+							original := tx.ctx
+							defer func() { tx.ctx = original }()
+							var want directory.Entry
+							var wantErr error
+							var wantTrace []string
+							failure := errors.New("normalizer failure")
+							for _, readonly := range []bool{false, true} {
+								var trace []string
+								tx.ctx = &entryReadTraceContext{Context: original, trace: &trace, cancelAt: cancelAt}
+								normalizer := entryReadTraceNormalizer{boltModifyReadOnlySchema: schema, trace: &trace}
+								if normalizeFails {
+									normalizer.failure = failure
+								}
+								scoped := schemaAwarePartitionReader{partitionReader: partitionReader{Reader: reader, partition: "db"}, normalizer: normalizer, allowLegacy: allowLegacy}
+								var entry directory.Entry
+								var err error
