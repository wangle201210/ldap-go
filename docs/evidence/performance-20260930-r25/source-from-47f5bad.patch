+		name     string
+		encoded  []byte
+		borrowed bool
+	}
+	var cases []testCase
+	for _, format := range []string{"v1", "v2", "v3", "json"} {
+		encoded := encodeCandidateTestEntry(t, entry, "unrelated identity", format)
+		cases = append(cases,
+			testCase{format + "/unvalidated-DN-binding", encoded, format != "json"},
+			testCase{format + "/trailing", append(bytes.Clone(encoded), 0), false},
+			testCase{format + "/truncated", bytes.Clone(encoded[:len(encoded)-1]), false},
+		)
+	}
+	for _, size := range []int{8191, 8192, 8193} {
+		candidate := entry.Clone()
+		encoded := encodeCandidateTestEntry(t, candidate, "unrelated identity", "v3")
+		values := candidate.Attributes[0].Values
+		values[0] = values[0][:len(values[0])-(len(encoded)-size)]
+		encoded = encodeCandidateTestEntry(t, candidate, "unrelated identity", "v3")
+		if len(encoded) != size {
+			t.Fatalf("threshold fixture size = %d, want %d", len(encoded), size)
+		}
+		cases = append(cases, testCase{fmt.Sprintf("bytes/%d", size), encoded, size >= 8192})
+	}
+	for _, attributes := range []int{64, 65} {
+		candidate := entry.Clone()
+		for len(candidate.Attributes) < attributes {
+			candidate.Attributes = append(candidate.Attributes, directory.Attribute{Description: "extra"})
+		}
+		cases = append(cases, testCase{fmt.Sprintf("attributes/%d", attributes), encodeCandidateTestEntry(t, candidate, "unrelated", "v3"), attributes <= 64})
+	}
+	for _, count := range []int{4096, 4097} {
+		candidate := directory.Entry{DN: entry.DN, Attributes: []directory.Attribute{
+			{Description: "first", Values: [][]byte{[]byte("first")}},
+			{Description: "member", Values: make([][]byte, count-1)},
+		}}
+		for i := range candidate.Attributes[1].Values {
+			candidate.Attributes[1].Values[i] = []byte("value")
+		}
+		cases = append(cases, testCase{fmt.Sprintf("total-values/%d", count), encodeCandidateTestEntry(t, candidate, "unrelated", "v3"), count <= 4096})
+	}
+	flagsEntry := encodeCandidateTestEntry(t, entry, "unrelated", "v3")
+	flags, _, err := consumeEntryBinaryField(flagsEntry[len(entryBinaryV3Prefix):])
+	if err != nil {
+		t.Fatal(err)
+	}
+	flags[0] |= 0x80
+	cases = append(cases, testCase{"invalid-normalization-bit", flagsEntry, false})
+	cases = append(cases, testCase{"unrecognized", append([]byte{0, 'L', 'G', 'E', 99}, bytes.Repeat([]byte("x"), 9000)...), false})
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			if err := store.Update(t.Context(), func(writer Writer) error {
+				return writer.(*boltTx).entries.Put(key, test.encoded)
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if err := store.View(t.Context(), func(reader Reader) error {
+				scoped := ReaderInPartitionWithNormalizer(reader, "db", schema)
+				want, wantErr := scoped.Get(dn)
+				var lease EntryReadLease
+				defer lease.Release()
+				got, err := GetReadOnly(scoped, dn, &lease)
+				assertEntryReadEqual(t, got, err, want, wantErr)
+				if (lease.decoder != nil) != test.borrowed {
