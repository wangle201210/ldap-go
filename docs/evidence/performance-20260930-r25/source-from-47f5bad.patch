+								if readonly && !slices.Equal(trace, append(slices.Clone(wantTrace), "consumer")) {
+									t.Fatal("release added callbacks")
+								}
+							}
+							return nil
+						}); err != nil {
+							t.Fatal(err)
+						}
+					}
+				}
