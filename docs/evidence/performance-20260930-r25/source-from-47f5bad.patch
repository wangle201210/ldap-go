+package server
+
+import (
+	"bytes"
+	"errors"
+	"slices"
+	"testing"
+
+	ber "github.com/go-asn1-ber/asn1-ber"
+	ldap "github.com/go-ldap/ldap/v3"
+	"github.com/wangle201210/ldap-go/internal/ldapwire"
+	"github.com/wangle201210/ldap-go/internal/storage"
+)
+
+func compareReadLeaseWire(t *testing.T, server *Server, state *connectionState, message ldapwire.Message, want ldapwire.ResultCode) []byte {
+	t.Helper()
+	capture := &smallIndexedCapture{}
+	if err := server.handleCompare(t.Context(), capture, state, message, message.Request.(ldapwire.CompareRequest)); err != nil {
+		t.Fatal(err)
+	}
+	reader := bytes.NewReader(capture.Bytes())
+	packet, err := ber.ReadPacket(reader)
+	if err != nil || reader.Len() != 0 {
+		t.Fatalf("BER error=%v, trailing bytes=%d", err, reader.Len())
+	}
+	result, err := parseSyncConsumerLDAPResult(packet, message.ID, ldapwire.ApplicationCompareResponse)
+	if err != nil || result.code != uint16(want) {
+		t.Fatalf("result=%+v, error=%v, want=%d", result, err, want)
+	}
+	if want == ldapwire.ResultInappropriateMatching && result.diagnosticMessage == "" ||
+		want == ldapwire.ResultNoSuchObject && result.matchedDN == "" ||
+		want == ldapwire.ResultReferral && len(ldapResultReferrals(packet)) == 0 {
+		t.Fatalf("missing diagnostic, matched DN or referrals: %+v", result)
+	}
+	return bytes.Clone(capture.Bytes())
+}
+
+func checkCompareReadLeaseWire(t *testing.T, server *Server, state *connectionState, message ldapwire.Message, want ldapwire.ResultCode, eligible bool) {
+	t.Helper()
+	request := message.Request.(ldapwire.CompareRequest)
+	dn, err := parseCoreWriteDN(state.runtime, request.DN)
+	if err != nil {
+		t.Fatal(err)
+	}
+	database := databaseForNormalizedDN(state.runtime, dn)
+	store, cache := server.config.Store, state.runtime.compareDNPrefixes
+	defer func() { server.config.Store, state.runtime.compareDNPrefixes = store, cache }()
+	var wire []byte
+	for _, owned := range []bool{false, true} {
+		if owned {
+			// This wrapper deliberately forces entryOrReferralWithReadLease(nil)
+			// and Reader.Get. The candidate above must retain the plain Bolt gate.
+			server.config.Store = &smallIndexedObservedStore{Store: store}
+			state.runtime.compareDNPrefixes = nil
+		}
+		if err := server.config.Store.View(t.Context(), func(reader storage.Reader) error {
+			if got := server.compareReadLeaseSource(state, database, request.Attribute, len(message.Controls) != 0 || message.ControlsPresent, reader) != nil; got != (eligible && !owned) {
+				t.Fatalf("owned=%v: lease gate=%v, want=%v", owned, got, eligible && !owned)
+			}
+			return nil
+		}); err != nil {
+			t.Fatal(err)
+		}
+		got := compareReadLeaseWire(t, server, state, message, want)
+		if owned && !bytes.Equal(wire, got) {
+			t.Fatalf("candidate wire=%x, owned Get wire=%x", wire, got)
+		}
+		wire = got
+	}
+}
+
+func TestCompareReadLeaseWireAndMutations(t *testing.T) {
+	server, state := newSmallIndexedFixture(t, 0)
+	state.protocolVersion = 3
+	group := defaultProjectionBenchmarkEntry(true)
+	// Avoid withSubschemaReference cloning the borrowed entry before comparison.
+	group.ReplaceValues("subschemaSubentry", stringValues("cn=Subschema"))
+	smallIndexedPut(t, server, state, group, false)
+	other := group.Clone()
+	other.DN = "cn=otherGroup,dc=example,dc=com"
+	other.ReplaceValues("cn", stringValues("otherGroup"))
+	other.ReplaceValues("member", compareDNPrefixTestEntry(1000).Values("member"))
+	smallIndexedPut(t, server, state, other, false)
+	members, otherMembers := group.Values("member"), other.Values("member")
+	missing := []byte("uid=absent," + smallIndexedPeopleDN)
+	message := ldapwire.Message{ID: 17, Request: ldapwire.CompareRequest{DN: group.DN, Attribute: "member", Assertion: missing}}
+	check := func(label, dn string, assertion []byte, want ldapwire.ResultCode) {
+		t.Helper()
+		t.Run(label, func(t *testing.T) {
+			request := ldapwire.CompareRequest{DN: dn, Attribute: "member", Assertion: assertion}
+			checkCompareReadLeaseWire(t, server, state, ldapwire.Message{ID: message.ID, Request: request}, want, true)
+		})
+	}
+	check("cold miss", group.DN, missing, ldapwire.ResultCompareFalse)
+	cache := state.runtime.compareDNPrefixes
+	if cache == nil {
+		t.Fatal("missing prefix cache")
+	}
+	// Each request releases its lease and closes its View. Alternate rows while
+	// warming so cached values must remain owned when the decoder is reused.
+	for i := range len(members) + 1 {
+		compareReadLeaseWire(t, server, state, message, ldapwire.ResultCompareFalse)
+		if i%32 == 0 {
+			otherMessage := ldapwire.Message{ID: 17, Request: ldapwire.CompareRequest{DN: other.DN, Attribute: "member", Assertion: missing}}
+			compareReadLeaseWire(t, server, state, otherMessage, ldapwire.ResultCompareFalse)
+		}
+	}
+	if len(cache.records) != 2 {
+		t.Fatalf("warmed prefix records=%d, want both groups", len(cache.records))
+	}
+	check("warm first", group.DN, members[0], ldapwire.ResultCompareTrue)
+	check("warm last", group.DN, members[999], ldapwire.ResultCompareTrue)
+	check("other last", other.DN, otherMembers[999], ldapwire.ResultCompareTrue)
+	check("other does not contain original", other.DN, members[999], ldapwire.ResultCompareFalse)
+	check("original after other", group.DN, members[999], ldapwire.ResultCompareTrue)
+	changed := group.Clone()
+	values := changed.Values("member")
+	values[900] = missing
+	changed.ReplaceValues("member", values)
+	smallIndexedPut(t, server, state, changed, true)
+	check("modified old late member", group.DN, members[900], ldapwire.ResultCompareFalse)
+	check("modified new late member", group.DN, missing, ldapwire.ResultCompareTrue)
+	dn, err := parseCoreWriteDN(state.runtime, group.DN)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := server.config.Store.Update(t.Context(), func(writer storage.Writer) error {
+		return writerForDatabase(writer, *databaseForNormalizedDN(state.runtime, dn)).Delete(dn)
+	}); err != nil {
+		t.Fatal(err)
+	}
+	check("deleted", group.DN, missing, ldapwire.ResultNoSuchObject)
+	check("other after delete", other.DN, otherMembers[999], ldapwire.ResultCompareTrue)
+	smallIndexedPut(t, server, state, group, false)
+	check("recreated removed member", group.DN, missing, ldapwire.ResultCompareFalse)
+	check("recreated original member", group.DN, members[900], ldapwire.ResultCompareTrue)
+	if state.runtime.compareDNPrefixes != cache {
+		t.Fatal("mutations replaced the warmed prefix cache")
+	}
+	checkCompareDNPrefixAccounting(t, cache)
+}
+
+func TestCompareReadLeaseErrorOrder(t *testing.T) {
+	server, state := newSmallIndexedFixture(t, 0)
+	state.protocolVersion = 3
+	group := defaultProjectionBenchmarkEntry(true)
+	group.ReplaceValues("subschemaSubentry", stringValues("cn=Subschema"))
+	members := group.Values("member")
+	members[0] = []byte("not-a-dn")
+	group.ReplaceValues("member", members)
+	smallIndexedPut(t, server, state, group, false)
+	filter, err := ldap.CompileFilter("(cn=absent)")
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertion := ldapwire.Control{OID: assertionControlOID, Critical: true, HasValue: true, Value: filter.Bytes()}
+	manage := ldapwire.Control{OID: manageDsaITControlOID, Critical: true}
+	check := func(label string, want ldapwire.ResultCode, controls ...ldapwire.Control) {
+		t.Helper()
+		t.Run(label, func(t *testing.T) {
+			request := ldapwire.CompareRequest{DN: group.DN, Attribute: "member", Assertion: members[999]}
+			checkCompareReadLeaseWire(t, server, state, ldapwire.Message{ID: 17, Request: request, Controls: controls}, want, len(controls) == 0)
+		})
+	}
+	check("malformed before match", ldapwire.ResultInappropriateMatching)
+	state.boundDN = ""
+	check("ACL before malformed member", ldapwire.ResultInsufficientAccessRights)
+	check("ACL before assertion", ldapwire.ResultInsufficientAccessRights, assertion)
+	state.boundDN = smallIndexedRootDN
+	check("assertion before malformed member", ldapwire.ResultAssertionFailed, assertion)
+	group.ReplaceValues("objectClass", stringValues("referral", "extensibleObject"))
+	group.ReplaceValues("ref", stringValues("ldap://remote.example/dc=remote,dc=example"))
+	smallIndexedPut(t, server, state, group, true)
+	check("referral before malformed member", ldapwire.ResultReferral)
+	check("referral before assertion", ldapwire.ResultReferral, assertion)
+	state.runtime.access = defaultProjectionPolicy(t, defaultProjectionRules(t,
+		"to attrs=member by * none", "to * by * read"), nil)
+	state.boundDN = ""
+	check("referral before denied compare", ldapwire.ResultReferral)
+	check("managed referral ACL before assertion", ldapwire.ResultInsufficientAccessRights, manage, assertion)
+	state.boundDN = smallIndexedRootDN
+	check("managed referral assertion", ldapwire.ResultAssertionFailed, manage, assertion)
+	check("managed referral malformed member", ldapwire.ResultInappropriateMatching, manage)
+}
