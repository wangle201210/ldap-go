+package server
+
+import (
+	"testing"
+
+	"github.com/wangle201210/ldap-go/internal/ldapwire"
+	"github.com/wangle201210/ldap-go/internal/storage"
+)
+
+func BenchmarkCompareReadLeaseGate(b *testing.B) {
+	server, state := newSmallIndexedFixture(b, 0)
+	state.protocolVersion = 3
+	dn, err := parseCoreWriteDN(state.runtime, "cn=group,"+smallIndexedPeopleDN)
+	if err != nil {
+		b.Fatal(err)
+	}
+	database := databaseForNormalizedDN(state.runtime, dn)
+	if err := server.config.Store.View(b.Context(), func(reader storage.Reader) error {
+		if server.compareReadLeaseSource(state, database, "member", false, reader) == nil {
+			b.Fatal("fixture is not eligible")
+		}
+		b.ReportAllocs()
+		for b.Loop() {
+			if server.compareReadLeaseSource(state, database, "member", false, reader) == nil {
+				b.Fatal("fixture became ineligible")
+			}
+		}
+		return nil
+	}); err != nil {
+		b.Fatal(err)
+	}
+}
+
+// Repeated failures also have to return the borrowed decoder before View ends.
+func BenchmarkCompareReadLeaseFailure(b *testing.B) {
+	for _, scenario := range []string{"malformed-member", "denied", "referral"} {
+		b.Run(scenario, func(b *testing.B) {
+			server, state := newSmallIndexedFixture(b, 0)
+			state.protocolVersion = 3
+			group := defaultProjectionBenchmarkEntry(true)
+			group.ReplaceValues("subschemaSubentry", stringValues("cn=Subschema"))
+			assertion := []byte("uid=absent," + smallIndexedPeopleDN)
+			want := ldapwire.ResultInappropriateMatching
+			switch scenario {
+			case "malformed-member":
+				members := group.Values("member")
+				members[0] = []byte("bad-dn")
+				group.ReplaceValues("member", members)
+			case "denied":
+				state.boundDN = smallNonRootReaderDN
+				state.runtime.access = defaultProjectionPolicy(b, defaultProjectionRules(b,
+					"to attrs=member by * none", "to * by users read by * none"), nil)
+				want = ldapwire.ResultInsufficientAccessRights
+			case "referral":
+				group.ReplaceValues("objectClass", stringValues("referral", "extensibleObject"))
+				group.ReplaceValues("ref", stringValues("ldap://other.example/dc=other"))
+				want = ldapwire.ResultReferral
+			}
+			smallIndexedPut(b, server, state, group, false)
+			request := ldapwire.CompareRequest{DN: group.DN, Attribute: "member", Assertion: assertion}
+			message := ldapwire.Message{ID: 1, Request: request}
+			capture := &smallIndexedCapture{}
+			run := func() {
+				capture.Reset()
+				if err := server.handleCompare(b.Context(), capture, state, message, request); err != nil {
+					b.Fatal(err)
+				}
+			}
+			run()
+			if code, ok := auditLDAPResultCode(capture.Bytes()); !ok || code != int(want) {
+				b.Fatalf("result=%d, decoded=%v, want=%d", code, ok, want)
+			}
+			b.ReportAllocs()
+			for b.Loop() {
+				run()
+			}
+			if code, ok := auditLDAPResultCode(capture.Bytes()); !ok || code != int(want) {
+				b.Fatalf("result=%d, decoded=%v, want=%d", code, ok, want)
+			}
+		})
+	}
+}
