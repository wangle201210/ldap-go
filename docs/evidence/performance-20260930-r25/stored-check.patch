+// NewEntryReadLeaseWithCheck additionally requires check to allow borrowing.
+// The check runs synchronously only after a large binary row has been found,
+// before a decoder is acquired. It must not mutate the reader, lease or policy.
+// A false result retains the original owned decode and its errors. The caller
+// must still establish the source and normalizer contracts before this point.
+func NewEntryReadLeaseWithCheck(source Reader, check func() bool) EntryReadLease {
+	lease := NewEntryReadLease(source)
+	lease.check = check
+	return lease
+}
+
 // Release invalidates borrowed entry descriptors and values. It is idempotent;
 // owned copies, DN strings and attribute descriptions remain valid. A source
 // binding remains available for reuse within the same View.
