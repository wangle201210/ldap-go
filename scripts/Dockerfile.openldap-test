FROM golang:1.26-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        krb5-admin-server \
        krb5-kdc \
        krb5-user \
        libcrypt-dev \
        libevent-dev \
        libltdl-dev \
        libssl-dev \
        libsasl2-dev \
        libsasl2-modules \
        libsasl2-modules-gssapi-mit \
        libsqliteodbc \
        libtool \
        pkg-config \
        sasl2-bin \
        shellcheck \
        sqlite3 \
        unixodbc \
        unixodbc-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory /workspace

RUN printf '%s\n' 'export PATH=/usr/local/go/bin:/go/bin:$PATH' \
    > /etc/profile.d/ldap-go-go-path.sh

ENV PATH=/usr/local/go/bin:/go/bin:${PATH} \
    CGO_ENABLED=0 \
    GOPROXY=https://goproxy.cn,direct \
    OPENLDAP_SOURCE_CACHE=/var/cache/ldap-go-openldap/source \
    BUILD=/var/cache/ldap-go-openldap/build \
    ODBC_PREFIX=/usr \
    LDAP_GO_OPENLDAP_STRICT=1 \
    LDAP_GO_FAIL_ON_OPTIONAL_SKIP=1

WORKDIR /workspace

CMD ["./scripts/test-openldap-full.sh"]
